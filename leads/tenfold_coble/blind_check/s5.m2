-- S5 : the a# = 0 locus (h(x) = 0).   args: prime seed
pr = value(scriptCommandLine#1);
seed = value(scriptCommandLine#2);
setRandomSeed(seed);
load "/home/claude/blind_check/common.m2";
lam = 0_kk; xv = {};
while true do (
    xv = {randNonzero(), randNonzero(), randNonzero()};
    lam = -((xv#0)^3 + (xv#1)^3 + (xv#2)^3) / (3*(xv#0)*(xv#1)*(xv#2));
    if 1 + lam^3 != 0 then break;
    );
<< "prime " << pr << " seed " << seed << " lam " << lam << " x " << xv << endl << flush;
<< "h(x) = " << hcub(xv, lam) << "  a# = " << asharp(lam, xv) << endl << flush;
F = Fof(0_kk, lam, xv);
dz = apply(zz, v -> diff(v, F));
dp = apply(pp, v -> diff(v, F));
dq = apply(qq, v -> diff(v, F));
hp = hcub(pp, lam); hq = hcub(qq, lam);
IV = ideal(dz | {hp, hq});
<< "S5: F in I_V ? " << (F % IV == 0) << endl << flush;
<< "S5: V(I_V): projective dim " << dim IV - 1 << ", degree " << degree IV << ", codim " << codim IV << ", numgens " << numgens IV << endl << flush;
<< "S5: Hilbert polynomial of R/I_V: " << toString hilbertPolynomial(IV, Projective=>false) << endl << flush;
J = ideal jacobian ideal F;
<< "S5 note: h(p), h(q) in Jacobian ideal J ? " << (hp % J == 0) << " " << (hq % J == 0) << " ; I_V subset J ? " << isSubset(IV, J) << endl << flush;
Phi = ideal random(R^1, R^{3:-2});
Ip = IV + ideal(dp | dq) + Phi;
<< "S5: I' == J + Phi ? " << (Ip == J + Phi) << endl << flush;
<< "S5: affine dim of R/I' = " << dim Ip << endl << flush;
<< "S5: Hilbert function of A', degrees 0..8: " << toString apply(9, d -> hilbertFunction(d, Ip)) << endl << flush;
-- cubics D_k (defined in R before quotient ring is created)
c27 = 27*(1+lam^3);
hz = hcub(zz, lam);
Dk = (k, mult) -> dMx(k) - mult * ((3*(xv#k)^2 + 3*lam*(xv#((k+1)%3))*(xv#((k+2)%3))) / c27) * hz;
as = asharp(lam, xv);
dadlam = -3*(xv#0)*(xv#1)*(xv#2)/c27 + hcub(xv,lam)*81*lam^2/c27^2;
Dlam = 3*as*(zz#0)*(zz#1)*(zz#2) + dadlam*hz + 3*(pp#0)*(pp#1)*(pp#2) + 3*(qq#0)*(qq#1)*(qq#2);
Dl = {Dk(0,1), Dk(1,1), Dk(2,1)};
assert(all(Dl, D -> ring D === R) and ring Dlam === R);
<< "S5 note: D_k in I_V ? " << toString apply(Dl, D -> D % IV == 0) << " ; D_k in J ? " << toString apply(Dl, D -> D % J == 0) << " ; D_k in sat(J)? " << toString (Js = saturate J; apply(Dl, D -> D % Js == 0)) << endl << flush;
A = R/Ip;
B3 = basis(3, A);
B6 = basis(6, A);
<< "S5: dim A'_3 = " << numColumns B3 << ", dim A'_6 = " << numColumns B6 << endl << flush;
if numColumns B6 == 1 then (
    soc = B6_(0,0);
    delta = (e) -> (if e == 0 then 0_kk else (c := e // soc; assert(c*soc == e); sub(c, kk)));
    n3 = numColumns B3;
    bl = flatten entries B3;
    G = matrix(kk, table(n3, n3, (i,j) -> delta(bl#i * bl#j)));
    << "S5: rank of pairing on cubics: " << rank G << " ; kernel dim on A'_3: " << n3 - rank G << endl << flush;
    inKer = (D) -> (DA := sub(D, A); all(bl, b -> DA*b == 0));
    scan(3, k -> << "S5: D_" << k << " in kernel: " << inKer(Dk(k,1)) << " ; in I'_3: " << (sub(Dk(k,1),A) == 0) << " ; doubled-h(z) version in kernel: " << inKer(Dk(k,2)) << " ; zero-h(z) version in kernel: " << inKer(Dk(k,0)) << endl << flush);
    cf = (D) -> last coefficients(matrix{{sub(D,A)}}, Monomials => B3);
    CM = sub(fold((a,b) -> a | b, apply(Dl, cf)), kk);
    kerG = gens ker G;
    << "S5: rank of {D_0,D_1,D_2} mod I'_3: " << rank CM << " ; rank[ker | D's] = " << rank(kerG | CM) << endl << flush;
    << "S5 extra: D_lam (formula of S4 at this lam,x) in kernel: " << inKer(Dlam) << " ; rank of {D_0,D_1,D_2,D_lam} mod I'_3: " << rank(CM | sub(cf Dlam, kk)) << endl << flush;
    Phi2 = ideal random(R^1, R^{3:-2});
    A2 = R/(J+Phi2);
    b2 = flatten entries basis(3, A2);
    << "S5 repeat with second random Phi: HF " << toString apply(8, d -> hilbertFunction(d, J+Phi2)) << " ; D_0,D_1,D_2,D_lam annihilate A'_3: " << toString apply(Dl | {Dlam}, D -> (DA := sub(D, A2); all(b2, b -> DA*b == 0))) << " ; doubled versions: " << toString apply(3, k -> (DA := sub(Dk(k,2), A2); all(b2, b -> DA*b == 0))) << endl << flush;
    eul = sum(3, k -> xv#k * Dk(k,1));
    << "S5 note: sum_k x_k D_k in I'_3 ? " << (sub(eul, A) == 0) << endl << flush;
    );
