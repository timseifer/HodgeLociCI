-- member: candidate c = 1, w-part option W1 (generated by make_member.py; rule in PREREG_exact.md)
S = kk[z_0..z_2, p_0..p_2, q_0..q_2, w_0..w_2];
hC = (a, b, c) -> a^3 + b^3 + c^3 + 9*a*b*c;
zz = {z_0,z_1,z_2}; ps = {p_0,p_1,p_2}; qs = {q_0,q_1,q_2}; xm = {4,3,3};
Mten = sum flatten apply(3, i -> apply(3, j -> xm#((i-j)%3) * zz#((i+j)%3) * ps#i * qs#j));
F8 = -221*hC(z_0,z_1,z_2) + 378*hC(p_0,p_1,p_2) + 378*hC(q_0,q_1,q_2) + 378*Mten;
Phi0 = (2)*z_0*p_0 + (1)*z_1*p_1 + (2)*z_0*p_2 + (-1)*p_2^2 + (-2)*p_0^2 + (-2)*z_1*z_2;
Phi1 = (-1)*p_1*p_2 + (-2)*q_0*q_2 + (-2)*q_0^2 + (2)*z_1*p_1 + (-1)*p_1*q_0 + (-2)*q_1^2;
Phi2 = (2)*z_1*q_2 + (-2)*p_0*q_0 + (1)*p_2*q_1 + (1)*z_0*p_1 + (-1)*p_1*q_2 + (2)*p_2^2;
Wpart = w_0^3 + w_1^3 + w_2^3;
F = F8 + w_0*Phi0 + w_1*Phi1 + w_2*Phi2 + Wpart;
