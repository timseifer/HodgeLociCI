p = value(commandLine#3); sd = value(commandLine#4);
load "/home/claude/blind_check3/setup.m2";
stdio << "=== EXTRA checks (for C5/C7c) p=" << p << " seed=" << sd << endl << flush;
IZp = pfaffians(4, blk {0,1,2,3,4});
IZ = ideal(F, pf4 {0,1,2,3}, pf4 {0,1,2,4}) : IZp;
IZp2 = pfaffians(4, blk {1,2,3,4,5});
IZ2 = ideal(F, pf4 {0,3,4,5}, pf4 {1,3,4,5}) : pfaffians(4, blk {0,1,3,4,5});
stdio << "proj. dim of R/I: Z " << pdim coker gens IZ << ", Z_2 " << pdim coker gens IZ2 << ", Z' " << pdim coker gens IZp << ", Z'_2 " << pdim coker gens IZp2 << "   (3 = codim => arithmetically Cohen-Macaulay)" << endl << flush;
N1 = submatrix(M, {0,1,2,3,4,5}, {0,1,2});
r1 = minors(2, N1);
stdio << "locus rank(columns 0,1,2) <= 1 (dim ker M cap <e0,e1,e2> >= 2): affine dim " << dim r1 << " degree " << degree r1 << ";  intersected with S: affine dim " << dim(IS + r1) << " degree " << degree(IS + r1) << endl << flush;
Psi1 = random(2,R); Psi2 = random(2,R);
nodes = IS + ideal(Psi1,Psi2);
scan({("Z",IZ),("Z_2",IZ2),("Z'",IZp),("Z'_2",IZp2)}, pr -> (
   sg := minors(3, jacobian pr#1);
   a := pr#1 + sg; b := IS + sg; c := nodes + sg;
   stdio << pr#0 << ": Sing: affine dim " << dim a << (if dim a > 0 then " degree " | toString degree a else "") << ";  Sing cap S: affine dim " << dim b << (if dim b > 0 then " degree " | toString degree b else "") << ";  Sing cap (56 nodes): affine dim " << dim c << endl << flush));
tick "sing";
-- ladder of hyperplane sections
R2 = kk[y_0..y_8,t_1,t_2];
up = map(R2, R, (gens R2)_{0..8});
use R; q11 = random(1,R); q12 = random(1,R); q22 = random(1,R);
use R2;
f = up F + t_1*up Psi1 + t_2*up Psi2 + t_1^2*up q11 + t_1*t_2*up q12 + t_2^2*up q22 + random(kk)*t_1^3 + random(kk)*t_1^2*t_2 + random(kk)*t_1*t_2^2 + random(kk)*t_2^3;
jd = g -> (I := ideal jacobian matrix{{g}}; d := dim I; (d, if d > 0 then degree I else 0));
S9 = kk[y_0..y_7,t_1,t_2];
g1 = map(S9, R2, (toList(y_0..y_7)) | {sum(8, i -> random(kk)*S9_i), t_1, t_2});
f4 = g1 f;
stdio << "level m=5: X'' = X' cap {l_a=0} (cubic 8-fold in P^9): Jacobian (affine dim, degree) = " << toString jd f4 << endl << flush;
tick "X4";
S8 = kk[y_0..y_7,t_1];
g2 = map(S8, S9, (toList(y_0..y_7)) | {t_1, 0});
f4n = g2 f4;
stdio << "level m=4: X' = {t_2=0} (cubic 7-fold in P^8): Jacobian (affine dim, degree) = " << toString jd f4n << endl << flush;
S7 = kk[y_0..y_6,t_1];
g3 = map(S7, S8, (toList(y_0..y_6)) | {sum(7, i -> random(kk)*S7_i), t_1});
f3 = g3 f4n;
stdio << "level m=4: X'' = X' cap {l_b=0} (cubic 6-fold in P^7): Jacobian (affine dim, degree) = " << toString jd f3 << endl << flush;
S6 = kk[y_0..y_6];
g4 = map(S6, S7, (toList(y_0..y_6)) | {0});
f3n = g4 f3;
stdio << "level m=3: X' = {t_1=0} (cubic 5-fold in P^6): Jacobian (affine dim, degree) = " << toString jd f3n << endl << flush;
S5 = kk[y_0..y_5];
g5 = map(S5, S6, (toList(y_0..y_5)) | {sum(6, i -> random(kk)*S5_i)});
stdio << "level m=3: X'' (cubic 4-fold in P^5): Jacobian (affine dim, degree) = " << toString jd(g5 f3n) << endl << flush;
tick "ladder";
