p = value(commandLine#3); sd = value(commandLine#4);
load "/home/claude/blind_check3/setup.m2";
stdio << "=== C3 p=" << p << " seed=" << sd << endl << flush;
Phi = ideal(random(2,R), random(2,R), random(2,R));
J = ideal jacobian matrix{{F}};
I1 = J + Phi; I3 = IS + Phi;
stdio << "HF R/(J,Phi)  deg 0..8: " << toString apply(9, d -> hilbertFunction(d, coker gens I1)) << endl;
stdio << "HF R/(IS,Phi) deg 0..8: " << toString apply(9, d -> hilbertFunction(d, coker gens I3)) << endl << flush;
tick "hf";
b6 = basis(6, R);                      -- 3003 monomials
nf6 = b6 % I3;                         -- normal forms
supp = unique flatten apply(flatten entries nf6, g -> flatten entries monomials g);
stdio << "standard monomials occurring in degree 6: " << #supp << endl;
s6 = supp#0;
lamvals = flatten entries sub(contract(s6, nf6), kk);
mons6 = flatten entries b6;
lam = hashTable apply(#mons6, i -> mons6#i => lamvals#i);
b3 = flatten entries basis(3, R);
stdio << "number of cubic monomials: " << #b3 << endl;
G = matrix(kk, table(#b3, #b3, (i,j) -> lam#(b3#i * b3#j)));
stdio << "rank of pairing matrix: " << rank G << "   symmetric: " << (G == transpose G) << endl << flush;
tick "pairing";
-- degree 3 part of I3 and of IS, as coordinate vectors on the 165 monomials
deg3part = I -> (
   g := (vars R) ** (gens I);   -- I is generated by quadrics, so I_3 = R_1 * I_2
   sub(last coefficients(g, Monomials => matrix{b3}), kk));
C3 = deg3part I3; CS = deg3part IS;
stdio << "dim (IS+Phi)_3 = " << rank C3 << "   dim (IS)_3 = " << rank CS << endl;
stdio << "G * (IS+Phi)_3 == 0 : " << (G*C3 == 0) << "    dim ker G = " << (#b3 - rank G) << endl;
stdio << "=> kernel equals (IS+Phi)_3 : " << ((G*C3 == 0) and (rank C3 == #b3 - rank G)) << endl << flush;
tick "done";
