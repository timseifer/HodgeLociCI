-- certificate: Sigma_A cap Sigma_B (rank <= 1 loci of tau + A, tau + B in P^8) versus C = Sing(G)
cert = value get "/home/claude/hodgelocici/leads/tenfold_coble/pairing/arcdata/certificate_32003_seed1.txt";
pr = cert#"p";
say = s -> (stdio << s << endl << flush;);
T0 = (ZZ/pr)[aa];
K = toField(T0/ideal(value cert#"minpoly"));
R = K[u_0..u_7, tau];
use R; aa = sub(aa_K, R);
lam = cert#"lam"; xs = cert#"x";
hyp = apply(cert#"hyperplane", value);
A = matrix apply(cert#"A", r -> apply(r, value));
B = matrix apply(cert#"B", r -> apply(r, value));
h = (v) -> v#0^3 + v#1^3 + v#2^3 + 3*lam*v#0*v#1*v#2;
a = -(h(xs)) * (1/(27*(1+lam^3)))_K;
coble = (z,pp,q) -> a*h(z) + h(pp) + h(q) + sum(3, i -> sum(3, j -> xs#((i-j)%3) * z#((i+j)%3) * pp#i * q#j));
G = coble(hyp_{0,1,2}, hyp_{3,4,5}, hyp_{6,7,8});
I3 = id_(R^3);
t0 = cpuTime();
IAB = minors(2, tau*I3 + A) + minors(2, tau*I3 + B);
say("Sigma_A cap Sigma_B: dim(affine) " | toString dim IAB | "  degree " | toString degree IAB | "  HP " | toString hilbertPolynomial(IAB, Projective => false) | "   time " | toString(cpuTime() - t0));
JG = ideal apply(8, i -> diff(R_i, G));
say("all partials of G vanish on Sigma_A cap Sigma_B (radical membership via saturation in tau-free direction): ");
ell = sum(8, i -> random(pr)*R_i) + random(pr)*tau;
IABs = saturate(IAB, ell);
say("   partials of G in sat(I_AB): " | toString isSubset(JG, IABs) | "   time " | toString(cpuTime() - t0));
E = eliminate(tau, IABs);
Ru = K[u_0..u_7];
g = map(Ru, R, (gens Ru) | {0});
E0 = g E; JGu = g JG;
ellu = sum(8, i -> random(pr)*Ru_i);
ICu = saturate(JGu, ellu);
say("projection of Sigma_A cap Sigma_B equals C = Sing(G): " | toString(saturate(E0, ellu) == ICu) | "   time " | toString(cpuTime() - t0));
