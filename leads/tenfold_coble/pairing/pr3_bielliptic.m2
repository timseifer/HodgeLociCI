-- R3 of PREREG_pairing.md: a bielliptic surface of degree 18 in P^8 (K of order 2): is it the singular locus of a cubic?
-- AI-written, unreviewed.  usage (from this folder):  M2 --script pr3_bielliptic.m2 p seed       (p = 3 mod 4)
-- E: v^2 = u^4 + al u^2 + be, tau(u, v) = (-u, -v) (a translation of order 2: no fixed point);  F: w^2 = g(s), g a cubic,
-- sigma(s, w) = (s, -w).  S = (E x F)/<(tau, sigma)>.  Sections of O_E(3 inf_+ + 3 inf_-): 1, u, u^2, u^3, v, uv;
-- of O_F(3 inf): 1, s, w.  The nine invariant products give S -> P^8 (line bundle of type (3,3), degree 18).
-- Controls of the routine "cubics singular along a surface": the K3 surface of genus 8 (expected 1: the Pfaffian) and
-- the abelian surface (expected 1: the Coble cubic).  Every number is MOD p.
load "../../../tooling/node_section/NodeSection.m2";
pp = value(scriptCommandLine#1); sd = value(scriptCommandLine#2); kk = ZZ/pp; setRandomSeed sd;
if pp % 4 != 3 then error "p = 3 mod 4 expected (square roots)";
R = kk[Y_0..Y_8];
singularCubics = IS -> ( B3 := super basis(3, IS); m2 := basis(2, R);
    rows := apply(9, i -> ( D := diff(R_i, B3) % IS; (coefficients(D, Monomials => m2))#1 ));
    Ker := gens ker lift(fold((a, b) -> a || b, rows), kk);
    (numColumns B3, flatten entries (B3 * sub(Ker, R))));

-- controls
skew6 = () -> ( Lf := new MutableHashTable; scan(6, i -> scan(6, j -> if i < j then Lf#(i,j) = random(1, R)));
    matrix table(6, 6, (i,j) -> if i < j then Lf#(i,j) else if i > j then -Lf#(j,i) else 0_R));
Mk = skew6(); IK3 = pfaffians(4, Mk);
rK = singularCubics IK3;
<< "control K3 (genus 8): cubics containing S: " << rK#0 << " ; singular along S: " << #(rK#1) << " ; it is the Pfaffian: "
   << (#(rK#1) == 1 and rank lift((coefficients(matrix{{(rK#1)#0, (gens pfaffians(6, Mk))_(0,0)}}, Monomials => basis(3, R)))#1, kk) == 1) << endl << flush;
hs = (v, l) -> v#0^3+v#1^3+v#2^3 + 3*l*v#0*v#1*v#2;
lam = random kk; xx = apply(3, i -> random kk); a0 = - hs(xx, lam) / (27 * (1 + lam^3));
zz = {Y_0,Y_1,Y_2}; ps = {Y_3,Y_4,Y_5}; qs = {Y_6,Y_7,Y_8};
FC = a0 * hs(zz, lam) + hs(ps, lam) + hs(qs, lam) + sum flatten apply(3, i -> apply(3, j -> zz#((i+j)%3) * xx#((i-j)%3) * ps#i * qs#j));
IA = saturate ideal jacobian matrix{{FC}};
rA = singularCubics IA;
<< "control abelian (3,3): degree " << degree IA << " ; cubics containing S: " << rA#0 << " ; singular along S: " << #(rA#1) << " ; it is the Coble cubic: "
   << (#(rA#1) == 1 and rank lift((coefficients(matrix{{(rA#1)#0, FC}}, Monomials => basis(3, R)))#1, kk) == 1) << endl << flush;

-- the bielliptic surface, by interpolation through points over ZZ/p
al = random kk; be = random kk; g0 = random kk; g1 = random kk; g2 = random kk;
qE = u -> u^4 + al * u^2 + be; gF = s -> s^3 + g2 * s^2 + g1 * s + g0;
P1 = kk[uu]; discE = discriminant(uu^4 + al * uu^2 + be, uu); discF = discriminant(uu^3 + g2*uu^2 + g1*uu + g0, uu);
<< "bielliptic: E and F smooth (discriminants nonzero): " << (discE != 0 and discF != 0) << " ; be != 0 (tau has no fixed point): " << (be != 0) << endl;
sqrtK = a -> ( r := a^((pp+1)//4); if r^2 == a then r else null );
pts = {};
while #pts < 420 do ( u := random kk; v := sqrtK qE u; s := random kk; w := sqrtK gF s;
    if v =!= null and w =!= null and v != 0 and w != 0 then (
        if random 2 == 0 then v = -v; if random 2 == 0 then w = -w;
        pts = append(pts, {1_kk, u^2, u*v, s, u^2*s, u*v*s, u*w, u^3*w, v*w})));
evalAt = (m, pt) -> lift(sub(m, apply(9, i -> R_i => pt#i)), kk);
interp = (d, n) -> ( m := basis(d, R); E := fold((a, b) -> a || b, apply(take(pts, n), pt -> evalAt(m, pt))); flatten entries (m * sub(gens ker E, R)) );
q2 = interp(2, 200); q2b = interp(2, 420);
c3 = interp(3, 300); c3b = interp(3, 420);
<< "bielliptic: quadrics through 200 / 420 points: " << #q2 << " / " << #q2b << " (45 - 36 = 9) ; cubics through 300 / 420 points: " << #c3 << " / " << #c3b << " (165 - 81 = 84)" << endl << flush;
-- exactness: the interpolated forms vanish identically on the surface (symbolic check on E x F)
A = kk[ue, ve, se, we] / ideal(ve^2 - (ue^4 + al*ue^2 + be), we^2 - (se^3 + g2*se^2 + g1*se + g0));
toA = map(A, R, {1_A, ue^2, ue*ve, se, ue^2*se, ue*ve*se, ue*we, ue^3*we, ve*we});
<< "bielliptic: the interpolated quadrics and cubics vanish identically on S: " << (toA matrix{q2b} == 0 and toA matrix{c3b} == 0) << endl << flush;
IB = ideal(q2b) + ideal(c3b);
IBs = saturate IB;
<< "bielliptic: ideal generated by them: dim " << dim IB - 1 << ", degree " << degree IB << ", Hilbert polynomial " << toString hilbertPolynomial(IB, Projective => false)
   << " ; saturated: " << (IBs == IB) << " ; Hilbert function 0..5 of the saturation: " << toString apply(6, j -> hilbertFunction(j, R/IBs)) << " (9 n^2: " << toString apply(6, j -> 9*j^2) << ")" << endl << flush;
rB = singularCubics IBs;
<< "RESULT bielliptic (type (3,3), degree 18): cubics containing S: " << rB#0 << " ; cubics singular along S: " << #(rB#1) << endl << flush;
if #(rB#1) > 0 then (
    G := sum apply(rB#1, f -> random(kk) * f);
    Js := saturate ideal jacobian matrix{{G}};
    << "bielliptic: a general such cubic: singular locus of dim " << dim Js - 1 << ", degree " << degree Js << " ; Jacobian saturation equals I_S: " << (Js == IBs) << endl << flush;
    if Js == IBs then (
        T := kk[Y_0..Y_8, w_0..w_2]; inc := map(T, R, (vars T)_{0..8});
        FT := inc G + sum(3, k -> T_(9+k) * inc random(2, R)) + sum flatten apply(3, k -> apply(3, l -> T_(9+k) * T_(9+l) * random(1, T)));
        << "bielliptic: the tenfold is smooth: " << (dim ideal leadTerm groebnerBasis(ideal jacobian matrix{{FT}}, Strategy => "F4") == 0) << endl << flush;
        r := nodalSectionReport(FT, T_11 - random(kk) * T_10 - random(kk) * T_9);
        << "RESULT bielliptic, hyperplane section through the P^8: dim Sing " << r#"singularLocusDim" << ", points " << r#"singularPoints" << ", all ODP "
           << r#"allOrdinaryDoublePoints" << ", form degree " << r#"formDegree" << ", conditions " << r#"conditions" << ", defect " << r#"defect"
           << ", Hilbert function of the nodes " << toString r#"hilbertFunctionOfNodes" << "  [" << r#"label" << "]" << endl << flush));
<< "DONE p " << pp << " seed " << sd << endl;
