ring r=32003,(z0,z1,z2,p0,p1,p2,q0,q1,q2,w0,w1,w2),dp;
poly lam0=((1)*z0+(1)*z1+(2)*z2);
poly lam1=((-1036)*z0+(-124)*z1+(387)*p0+(345)*p1);
poly lam2=((2641)*z0+(-611)*z1+(-1212)*p0+(1380)*p2);
poly lam3=((-2411)*z0+(841)*z1+(1212)*p0+(1380)*q0);
poly lam4=((1496)*z0+(584)*z1+(-387)*p0+(345)*q1);
poly lam5=((3)*z0+(3)*z1+(1)*p0+(1)*q2);
poly Phi0=lam0*((1)*z1+(1)*z2+(1)*w0) + lam1*((1)*q0+(-1)*q1+(-1)*w2) + lam2*((-1)*z0+(1)*q0+(1)*w1) + lam3*((1)*p0+(-1)*w0+(-1)*w2) + lam4*((-1)*z0+(-1)*q2+(1)*w2) + lam5*((1)*z0+(-1)*q0+(1)*q2);
poly Phi1=lam0*((-1)*p0+(1)*p2+(-1)*q2) + lam1*((-1)*z0+(-1)*p1+(1)*q0+(1)*w1) + lam2*((1)*z1+(-1)*p2+(1)*q2) + lam3*((1)*p1+(1)*q1+(-1)*w0) + lam4*((-1)*p0+(1)*q0+(1)*w1) + lam5*((-1)*z1+(-1)*q1+(1)*q2);
poly Phi2=lam0*((1)*z0+(1)*p2+(-1)*q1) + lam1*((-1)*w0+(-1)*w1+(1)*w2) + lam2*((1)*z0+(-1)*p0+(-1)*q2+(1)*w2) + lam3*((1)*p2+(1)*q2+(1)*w0) + lam4*((1)*q2+(-1)*w0+(-1)*w1) + lam5*((1)*p0+(1)*q2+(-1)*w2);
poly F=(29)*z0*z0*z0 + (-174)*z0*z1*z2 + (8)*z0*p0*q0 + (1)*z0*p1*q2 + (18)*z0*p2*q1 + (29)*z1*z1*z1 + (1)*z1*p0*q1 + (18)*z1*p1*q0 + (8)*z1*p2*q2 + (29)*z2*z2*z2 + (18)*z2*p0*q2 + (8)*z2*p1*q1 + (1)*z2*p2*q0 + (1)*p0*p0*p0 + (-6)*p0*p1*p2 + (1)*p1*p1*p1 + (1)*p2*p2*p2 + (1)*q0*q0*q0 + (-6)*q0*q1*q2 + (1)*q1*q1*q1 + (1)*q2*q2*q2;
poly X=F+w0*Phi0+w1*Phi1+w2*Phi2;
ideal J=jacob(X);
option(redSB);
int tt=timer;
ideal S=slimgb(J);
print("mod 32003: dim of the affine cone of Sing(X) (0 = smooth):"); dim(S);
print("vdim:"); vdim(S);
quit;
