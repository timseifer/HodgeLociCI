ring r=0,(s0,s1,s2,s3),dp;
option(redSB);
poly F=-1716*s0^3 + 2144*s0^2*s1 - 416*s0*s1^2 - 1690*s1^3 - 480*s0^2*s2 + 975*s0*s1*s2 - 3132*s1^2*s2 + 255*s0*s2^2 - 1213*s1*s2^2 - 191*s2^3 - 761*s0^2*s3 - 1134*s0*s1*s3 + 3810*s1^2*s3 + 83*s0*s2*s3 + 4076*s1*s2*s3 + 808*s2^2*s3 + 1571*s0*s3^2 - 2416*s1*s3^2 - 1486*s2*s3^2 + 209*s3^3;
poly Q=-806*s0^2 - 256*s0*s1 + 2276*s1^2 - 258*s0*s2 + 3660*s1*s2 + 916*s2^2 + 3068*s0*s3 - 3088*s1*s3 - 1778*s2*s3 - 526*s3^2;
poly G=19276801755056*s0^5 - 89013545341296*s0^4*s1 + 65359047333344*s0^3*s1^2 - 31505919468768*s0^2*s1^3 + 5198739088000*s0*s1^4 - 11602688336*s1^5 - 22145474663760*s0^4*s2 - 28798740993344*s0^3*s1*s2 + 20694633544672*s0^2*s1^2*s2 - 16546857431520*s0*s1^3*s2 + 1014037953664*s1^4*s2 - 19795063615056*s0^3*s2^2 + 17764654052208*s0^2*s1*s2^2 - 11550653655744*s0*s1^2*s2^2 - 1554631604208*s1^3*s2^2 + 2889475874256*s0^2*s2^3 + 1919738760448*s0*s1*s2^3 - 2784836026048*s1^2*s2^3 + 1750625221216*s0*s2^4 - 1410985222864*s1*s2^4 - 320564889120*s2^5 + 38186896462976*s0^4*s3 + 79254062714816*s0^3*s1*s3 - 25471665247472*s0^2*s1^2*s3 + 6748762050208*s0*s1^3*s3 - 2231454570064*s1^4*s3 + 70451670717952*s0^3*s2*s3 + 44783032729936*s0^2*s1*s2*s3 - 2900612171472*s0*s1^2*s2*s3 + 2271703191936*s1^3*s2*s3 + 32707205183344*s0^2*s2^2*s3 + 4130239251568*s0*s1*s2^2*s3 + 5867002660720*s1^2*s2^2*s3 + 853309327472*s0*s2^3*s3 + 1454719919360*s1*s2^3*s3 - 1216003581392*s2^4*s3 - 106913976610720*s0^3*s3^2 - 18527693171904*s0^2*s1*s3^2 + 11743122408288*s0*s1^2*s3^2 + 4104169019104*s1^3*s3^2 - 121234744209856*s0^2*s2*s3^2 + 3127553423584*s0*s1*s2*s3^2 + 3387887951440*s1^2*s2*s3^2 - 34619149588784*s0*s2^2*s3^2 + 2903407308032*s1*s2^2*s3^2 - 1016287352128*s2^3*s3^2 + 84667185312608*s0^2*s3^3 - 28701034132096*s0*s1*s3^3 - 8678087571664*s1^2*s3^3 + 55860424517984*s0*s2*s3^3 - 17899091602416*s1*s2*s3^3 + 6268091609040*s2^2*s3^3 - 10526517957520*s0*s3^4 + 15650496125680*s1*s3^4 + 610849390000*s2*s3^4 - 6955524100000*s3^5;
poly l1=-167854*s0^2 - 243908*s0*s1 - 27863*s1^2 - 103464*s0*s2 - 25257*s1*s2 + 14837*s2^2 + 315544*s0*s3 + 196734*s1*s3 + 241390*s2*s3 - 279700*s3^2;
poly l2=-509363*s0^2 + 495866*s0*s1 - 33271*s1^2 - 68499*s0*s2 + 148719*s1*s2 + 67807*s2^2 - 156052*s0*s3 - 130710*s1*s3 - 104479*s2*s3 + 176845*s3^2;
ideal I=F,Q,G;
ideal S=std(I);
print("projective: dim(affine cone), mult:"); dim(S); mult(S);
ideal Il = F,Q,G,l1,l2;
ideal Sl = std(Il);
print("dim of cone of L cap W cap {l1=l2=0} (0 means empty):"); dim(Sl);
// affine chart s3=1
ring ra=0,(s0,s1,s2),dp;
option(redSB);
map phi=r,s0,s1,s2,1;
ideal Ia=phi(I);
ideal Sa=std(Ia);
print("affine chart s3=1: dim, vdim:"); dim(Sa); vdim(Sa);
ring rl=0,(s0,s1,s2),lp;
option(redSB);
ideal Sl=fglm(ra,Sa);
print("size of lex GB:"); size(Sl);
int i;
for(i=1;i<=size(Sl);i++){ print("LEAD"); print(lead(Sl[i])); }
write(":w c4_lex.txt", string(Sl[1]));
for(i=2;i<=size(Sl);i++){ write(":a c4_lex.txt", string(Sl[i])); }
list fa=factorize(Sl[1]);
print("factor degrees of the univariate generator:");
for(i=1;i<=size(fa[1]);i++){ print(deg(fa[1][i])); print(fa[2][i]); }
quit;
