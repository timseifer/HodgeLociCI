/-- γ·gamD on P2 of `Dg`:  -720x0^3 - 552x0^2·x1 - 2775x0^2·x2 - 4431x0^2·x7 -/
def Dg_P2_gamN : Poly := [(0o3, -720), (0o12, -552), (0o102, -2775), (0o1002, -4431)]
/-- the plane P2 of `Dg` with its certificate data.  The quadrics, in the plane coordinates
(x0, x1, x2, x7):
    q[0] = x7^2 - x2·x7 + x2^2 - x1·x7 - x1·x2 - x1^2 - x0·x7 - x0·x2 - x0^2
    q[1] = x2·x7 - x1·x7 - x1·x2 - x1^2 + x0·x2 + x0·x1
    q[2] = x2·x7 + x2^2 + x1·x7 + x1·x2 + x1^2 + x0·x7 + x0·x2 - x0·x1
    q[3] = -x2·x7 + x2^2 + x1·x7 + x1·x2 - x1^2 - 2x0·x2 + x0·x1
    det Λ = 3x2·x7^2 + 4x2^2·x7 + 2x2^3 - 6x1·x7^2 - 2x1·x2·x7 - 2x1^2·x7 - x1^2·x2 + x0·x2·x7 - 4x0·x1·x7 - x0·x1·x2 -/
def Dg_P2 : PlaneData := mkP2 Dg Dg_P2_tauN 461478 Dg_P2_RN 70987314828 Dg_P2_gamN 592
theorem Dg_P2_wf : WellFormed Dg_P2 := by decide +kernel
theorem Dg_P2_tau_kills : TauKills Dg_P2 := by decide +kernel
theorem Dg_P2_jac0 : ev Dg_P2.tauN (cof0 (jacMat Dg_P2.qs)) = 58608 := by decide +kernel
theorem Dg_P2_jac1 : ev Dg_P2.tauN (cof1 (jacMat Dg_P2.qs)) = 1178334 := by decide +kernel
theorem Dg_P2_jac2 : ev Dg_P2.tauN (cof2 (jacMat Dg_P2.qs)) = 2477196 := by decide +kernel
theorem Dg_P2_jac3 : ev Dg_P2.tauN (cof3 (jacMat Dg_P2.qs)) = -6026178 := by decide +kernel
theorem Dg_P2_tau_jac : TauJac Dg_P2 :=
  tauJac_of Dg_P2 58608 1178334 2477196 (-6026178) Dg_P2_jac0 Dg_P2_jac1 Dg_P2_jac2 Dg_P2_jac3 (by decide +kernel)
theorem Dg_P2_trans_law : TransLaw Dg_P2 (Qq Dg) := by decide +kernel
theorem Dg_P2_R_kills_1 : RKillsAt Dg_P2 1 := by decide +kernel
theorem Dg_P2_R_kills_2 : RKillsAt Dg_P2 2 := by decide +kernel
theorem Dg_P2_R_kills_3 : RKillsAt Dg_P2 3 := by decide +kernel
theorem Dg_P2_R_kills : RKills Dg_P2 := by
  intro i hi
  have h : [0, 1, 2, 3].filter (fun i => i != Dg_P2.sp) = [1, 2, 3] := by decide +kernel
  rw [h] at hi
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl
  · exact Dg_P2_R_kills_1
  · exact Dg_P2_R_kills_2
  · exact Dg_P2_R_kills_3
theorem Dg_P2_R_special : RSpecial Dg_P2 := by decide +kernel
theorem Dg_P2_R_detLam : RDetLam Dg_P2 (Qq Dg) (detC Dg) := by decide +kernel
theorem Dg_P2_gamma : GammaDual Dg_P2 := by decide +kernel
/-- **c1 = R(γ²) = +det C** on P2 -/
theorem Dg_c1_residue : CValue Dg_P2 Dg_c1 := by decide +kernel
theorem Dg_c2_eq : Dg_c2 = -detC Dg := by decide +kernel
theorem Dg_c1_eq : Dg_c1 = detC Dg := by decide +kernel
/-- **closed formula at `Dg`:** c₂·λ² + c₁·λ = -det C·λ·(λ-1) for every integer λ -/
theorem Dg_closed_formula (lam : Int) :
    Dg_c2 * lam ^ 2 + Dg_c1 * lam = -detC Dg * lam * (lam - 1) :=
  closed_formula_of _ _ _ lam Dg_c2_eq Dg_c1_eq
/-- the same for every rational λ -/
theorem Dg_closed_formula_rat (lam : Rat) :
    (Dg_c2 : Rat) * lam ^ 2 + (Dg_c1 : Rat) * lam = -(detC Dg : Rat) * lam * (lam - 1) :=
  closed_formula_rat_of _ _ _ lam Dg_c2_eq Dg_c1_eq
/-- **degenerate case:** det C = 0, so the obstruction c₂λ² + c₁λ vanishes identically -/
theorem Dg_obstruction_zero (lam : Int) : Dg_c2 * lam ^ 2 + Dg_c1 * lam = 0 := by
  rw [Dg_closed_formula, Dg_detC]; simp

