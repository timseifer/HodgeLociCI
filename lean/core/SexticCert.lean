/-- casting Φ(N(B, G)) to ℚ -/
theorem nq_cast (Φ : Nat → Int) (B : Vec) (G : Poly) :
    qev (fun n => ((Φ n : Int) : Rat)) (qN (vtoQ B) (toQ G)) = ((ev Φ (N B G) : Int) : Rat) := by
  have h : ev Φ (N B G) + (ev2 Φ G (deriv 0 (B 0)) + (ev2 Φ G (deriv 1 (B 1)) + (ev2 Φ G (deriv 2 (B 2)) + ev2 Φ G (deriv 3 (B 3)))))
      = ev2 Φ (B 0) (deriv 0 G) + (ev2 Φ (B 1) (deriv 1 G) + (ev2 Φ (B 2) (deriv 2 G) + ev2 Φ (B 3) (deriv 3 G))) := by
    rw [ev_N]; simp only [nE]; omega
  have hq := congrArg (fun z : Int => (z : Rat)) h
  simp only [Rat.intCast_add] at hq
  simp only [qN, qdot, qgrad, qdivg, qadd, vtoQ, qev_append, qev_smul, qev_mul, qB_add_right, qderiv_toQ, qB_toQ]
  grind
/-- bilinearity of (B, G) ↦ Φ(N(B, G)) in the form needed -/
theorem nq_bilin (Φ : Nat → Rat) (X0 X1 X2 : QVec) (G1 G2 : QPoly) (r s : Rat) :
    qev Φ (qN (fun k => qadd (X0 k) (qadd (qsmul (-s) (X1 k)) (qsmul r (X2 k)))) (qadd G1 (qsmul (-s) G2)))
      = qev Φ (qN X0 G1) - s * qev Φ (qN X0 G2) - s * qev Φ (qN X1 G1) + s * s * qev Φ (qN X1 G2)
        + r * qev Φ (qN X2 G1) - r * s * qev Φ (qN X2 G2) := by
  simp only [qN, qdot, qgrad, qdivg, qadd, qev_append, qev_smul, qev_mul, qderiv_append, qderiv_smul,
    qB_add_left, qB_smul_left, qB_add_right, qB_smul_right]
  grind

/-- **First order, every r** (s = 1/r): from the three identities
g̃₁a₁ = g̃₂a₂ + Σ F_k B⁰_k,  g̃₂a₁ = Σ F_k B¹_k,  g̃₁a₂ = Σ F_k B²_k  it follows that
(g̃₁ − s g̃₂)(a₁ + r a₂) = Σ_k F_k (B⁰ − s B¹ + r B²)_k. -/
theorem first_order_general (a1 a2 gt1 gt2 : Poly) (dF B0 B1 B2 : Vec)
    (h0 : SamePoly (mul gt1 a1) (add (mul gt2 a2) (dot dF B0)))
    (h1 : SamePoly (mul gt2 a1) (dot dF B1)) (h2 : SamePoly (mul gt1 a2) (dot dF B2))
    (r s : Rat) (hrs : r * s = 1) (m : Nat) :
    qcoeff (qmul (famG gt1 gt2 s) (famA a1 a2 r)) m = qcoeff (qdot (vtoQ dF) (famB B0 B1 B2 r s)) m := by
  have e0 := h0 m; have e1 := h1 m; have e2 := h2 m
  simp only [add, dot, coeff_eq_ev, ev_append, ev_mul] at e0 e1 e2
  have c0 := congrArg (fun z : Int => (z : Rat)) e0
  have c1 := congrArg (fun z : Int => (z : Rat)) e1
  have c2 := congrArg (fun z : Int => (z : Rat)) e2
  simp only [Rat.intCast_add] at c0 c1 c2
  rw [qcoeff_eq_qev, qcoeff_eq_qev]
  simp only [famG, famA, famB, vtoQ, qdot, qadd, qev_append, qev_mul, qB_add_left, qB_smul_left, qB_add_right,
    qB_smul_right, qB_toQ]
  grind
/-- **Second order, every r** (s = 1/r): from the four numbers of (T5),
Φ(N(B, G)) = A₀·(1 + s) for B = B⁰ − s B¹ + r B², G = g̃₁ − s g̃₂. -/
theorem second_order_general (gt1 gt2 : Poly) (B0 B1 B2 : Vec) (Φ : Nat → Int) (A0 : Int)
    (n1 : ev Φ (N B2 gt1) = 0) (n2 : ev Φ (N B1 gt2) = 0)
    (n3 : ev Φ (N B0 gt1) - ev Φ (N B2 gt2) = A0) (n4 : -ev Φ (N B0 gt2) - ev Φ (N B1 gt1) = A0)
    (r s : Rat) (hrs : r * s = 1) :
    qev (fun n => ((Φ n : Int) : Rat)) (qN (famB B0 B1 B2 r s) (famG gt1 gt2 s)) = (A0 : Rat) * (1 + s) := by
  have key := nq_bilin (fun n => ((Φ n : Int) : Rat)) (vtoQ B0) (vtoQ B1) (vtoQ B2) (toQ gt1) (toQ gt2) r s
  rw [nq_cast, nq_cast, nq_cast, nq_cast, nq_cast, nq_cast] at key
  have e3 : ev Φ (N B0 gt1) = A0 + ev Φ (N B2 gt2) := by omega
  have e4 : ev Φ (N B0 gt2) + (ev Φ (N B1 gt1) + A0) = 0 := by omega
  have q3 := congrArg (fun z : Int => (z : Rat)) e3
  have q4 := congrArg (fun z : Int => (z : Rat)) e4
  simp only [Rat.intCast_add] at q3 q4
  rw [n1, n2] at key
  have z : ((0 : Int) : Rat) = 0 := rfl
  rw [z] at key q4
  refine key.trans ?_
  grind
theorem zero_iff_general (A0 : Int) (hA : A0 ≠ 0) (r : Rat) (hr : r ≠ 0) : (A0 : Rat) * (1 + r⁻¹) = 0 ↔ r = -1 := by
  have hA' : (A0 : Rat) ≠ 0 := by
    intro h; apply hA; exact_mod_cast h
  constructor
  · intro h; grind
  · intro h; subst h; grind


