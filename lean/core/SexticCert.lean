  induction p with
  | nil => rfl
  | cons t p ih => by_cases h : t.1 = m <;> simp [qcoeff, qev, delta, h, ih] <;> grind
theorem deriv_cons (k : Nat) (t : Nat × Int) (p : Poly) : deriv k (t :: p) =
    if expo t.1 k = 0 then deriv k p else (t.1 - 32 ^ k, (expo t.1 k : Int) * t.2) :: deriv k p := by
  by_cases h : expo t.1 k = 0 <;> simp [deriv, h]
theorem qderiv_cons (k : Nat) (t : Nat × Rat) (p : QPoly) : qderiv k (t :: p) =
    if expo t.1 k = 0 then qderiv k p else (t.1 - 32 ^ k, ((expo t.1 k : Int) : Rat) * t.2) :: qderiv k p := by
  by_cases h : expo t.1 k = 0 <;> simp [qderiv, h]
theorem qderiv_append (k : Nat) (p q : QPoly) : qderiv k (p ++ q) = qderiv k p ++ qderiv k q := by
  simp [qderiv]
