/-- the functional ρ (a monomial of degree 16 is looked up by its first three exponents) -/
def rho (m : Nat) : Int := lookup rhoTab m
/-- Q₀ = f₁·h₁ -/
def Q0 : Poly := mul f1 h1
/-- ρ_Q(m) = ρ(x₀x₁·m): the functional m ↦ ρ(Q₀·m) on S₁₄ (`Q0_monomial`, `ev_Q0`) -/
def rhoQ (n : Nat) : Int := rho (33 + n)
/-- the second-order constant -/
def A0 : Int := -110521443973923315186213835421630894893918086882752031759711199962075078840170693083129638000000

/-! ## 5. (T1) consistency of the definitions -/

/-- all the data are homogeneous of the right degrees -/
theorem degrees : isHomog 1 f1 = true ∧ isHomog 2 f2 = true ∧ isHomog 1 h1 = true ∧ isHomog 2 h2 = true
    ∧ isHomog 4 M11 = true ∧ isHomog 3 M12 = true ∧ isHomog 3 M21 = true ∧ isHomog 2 M22 = true
    ∧ isHomog 5 g1 = true ∧ isHomog 4 g2 = true ∧ isHomog 5 k1 = true ∧ isHomog 4 k2 = true ∧ isHomog 6 F = true
    ∧ isHomog 8 a1 = true ∧ isHomog 8 a2 = true ∧ isHomog 6 gt1 = true ∧ isHomog 6 gt2 = true
    ∧ isHomog 5 u1 = true ∧ isHomog 4 u2 = true ∧ isHomog 5 v1 = true ∧ isHomog 4 v2 = true ∧ isHomog 2 Q0 = true
    ∧ (∀ k ∈ [0, 1, 2, 3], isHomog 5 (dF k) = true ∧ isHomog 9 (B0 k) = true ∧ isHomog 9 (B1 k) = true
        ∧ isHomog 9 (B2 k) = true) := by
  decide +kernel
/-- g = M·h, k = Mᵀ·f, F = f₁g₁ + f₂g₂ = h₁k₁ + h₂k₂, as normal forms computed by the kernel -/
theorem T1_normal_forms : g1 = clean (addN (mulN M11 h1) (mulN M12 h2)) ∧ g2 = clean (addN (mulN M21 h1) (mulN M22 h2))
    ∧ k1 = clean (addN (mulN M11 f1) (mulN M21 f2)) ∧ k2 = clean (addN (mulN M12 f1) (mulN M22 f2))
    ∧ F = clean (addN (mulN f1 g1) (mulN f2 g2)) ∧ F = clean (addN (mulN h1 k1) (mulN h2 k2)) := by
  decide +kernel
theorem T1_g1 : SamePoly g1 (add (mul M11 h1) (mul M12 h2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], g1), (1, M11, h1), (1, M12, h2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
theorem T1_g2 : SamePoly g2 (add (mul M21 h1) (mul M22 h2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], g2), (1, M21, h1), (1, M22, h2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
theorem T1_k1 : SamePoly k1 (add (mul M11 f1) (mul M21 f2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], k1), (1, M11, f1), (1, M21, f2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
theorem T1_k2 : SamePoly k2 (add (mul M12 f1) (mul M22 f2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], k2), (1, M12, f1), (1, M22, f2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
/-- **F = f₁g₁ + f₂g₂** -/
theorem T1_F_fg : SamePoly F (add (mul f1 g1) (mul f2 g2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], F), (1, f1, g1), (1, f2, g2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
/-- **F = h₁k₁ + h₂k₂** -/
theorem T1_F_hk : SamePoly F (add (mul h1 k1) (mul h2 k2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], F), (1, h1, k1), (1, h2, k2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
/-- the literal F_k are the partial derivatives of F -/
theorem T1_dF : dF 0 = deriv 0 F ∧ dF 1 = deriv 1 F ∧ dF 2 = deriv 2 F ∧ dF 3 = deriv 3 F := by decide +kernel
/-- **a₁ = det Jac(f₁,f₂,g₁,g₂), a₂ = det Jac(h₁,h₂,k₁,k₂)** (the determinant is computed by the kernel: `jacN`) -/
theorem T1_jacobians : a1 = jacN f1 f2 g1 g2 ∧ a2 = jacN h1 h2 k1 k2 := by decide +kernel

/-! ## 6. (T2) the excess direction: three identities of degree 14 -/

/-- g̃₁ ∈ (h₁, h₂) = I(Z₂) -/
theorem T2_gt1_mem : SamePoly gt1 (add (mul h1 u1) (mul h2 u2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], gt1), (1, h1, u1), (1, h2, u2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
/-- g̃₂ ∈ (f₁, f₂) = I(Z₁) -/
theorem T2_gt2_mem : SamePoly gt2 (add (mul f1 v1) (mul f2 v2)) := by
  intro m
  have h := comb_zero [(-1, [(0, 1)], gt2), (1, f1, v1), (1, f2, v2)] (by decide +kernel) m
  simp only [comb, add, coeff_append, coeff_smul, one_mul, coeff_nil] at h ⊢; omega
/-- **g̃₁·a₁ = g̃₂·a₂ + Σ_k F_k·B⁰_k**, i.e. a₁g̃₁ − a₂g̃₂ = B⁰·∇F -/
theorem T2_id0 : SamePoly (mul gt1 a1) (add (mul gt2 a2) (dot dF B0)) := by
  intro m
  have h := comb_zero [(1, gt1, a1), (-1, gt2, a2), (-1, dF 0, B0 0), (-1, dF 1, B0 1), (-1, dF 2, B0 2),
    (-1, dF 3, B0 3)] (by decide +kernel) m
  simp only [comb, add, dot, coeff_append, coeff_smul, coeff_nil] at h ⊢; omega
/-- **g̃₂·a₁ = Σ_k F_k·B¹_k**, i.e. a₁g̃₂ = B¹·∇F -/
theorem T2_id1 : SamePoly (mul gt2 a1) (dot dF B1) := by
  intro m
  have h := comb_zero [(1, gt2, a1), (-1, dF 0, B1 0), (-1, dF 1, B1 1), (-1, dF 2, B1 2), (-1, dF 3, B1 3)]
    (by decide +kernel) m
  simp only [comb, add, dot, coeff_append, coeff_smul, coeff_nil] at h ⊢; omega
/-- **g̃₁·a₂ = Σ_k F_k·B²_k**, i.e. a₂g̃₁ = B²·∇F -/
theorem T2_id2 : SamePoly (mul gt1 a2) (dot dF B2) := by
  intro m
  have h := comb_zero [(1, gt1, a2), (-1, dF 0, B2 0), (-1, dF 1, B2 1), (-1, dF 2, B2 2), (-1, dF 3, B2 3)]
    (by decide +kernel) m
  simp only [comb, add, dot, coeff_append, coeff_smul, coeff_nil] at h ⊢; omega

/-! ## 7. (T3) the functional ρ on S₁₆ -/

/-- the table has the shape of the 969 monomials of degree 16 -/
theorem T3_rho_shape : rhoTab.length = 17 ∧ (∀ a ∈ List.range 17, (nth [] rhoTab a).length = 17 - a
    ∧ ∀ b ∈ List.range (17 - a), (nth [] (nth [] rhoTab a) b).length = 17 - a - b) ∧ (mons 16).length = 969
    ∧ (mons 11).length = 364 ∧ (mons 6).length = 84 := by
  decide +kernel
/-- **ρ vanishes on J₁₆:** ρ(m·F_k) = 0 for the 364 monomials m of degree 11 and k = 0..3 -/
theorem T3_rho_kills_J : ∀ k ∈ [0, 1, 2, 3], ∀ m ∈ mons 11, ev rho (mul [(m, 1)] (dF k)) = 0 := by
  decide +kernel
/-- the same for every exponent vector: ρ(x0^a x1^b x2^c x3^e·F_k) = 0 whenever a + b + c + e = 11 and k < 4 -/
theorem T3_rho_kills_J_all (k a b c e : Nat) (hk : k < 4) (h : a + b + c + e = 11) :
    ev rho (mul [(a + 32 * b + 1024 * c + 32768 * e, 1)] (dF k)) = 0 := by
  have hk' : k ∈ [0, 1, 2, 3] := by
    have : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 := by omega
    rcases this with rfl | rfl | rfl | rfl <;> decide
  exact T3_rho_kills_J k hk' _ (mem_mons 11 a b c e h)
/-- **ρ ≠ 0:** ρ(x₀¹⁶) ≠ 0 -/
theorem T3_rho_ne_zero : rho 16 ≠ 0 := by decide +kernel
/-- ρ(q·g̃₁·a₁) ≠ 0 for the quadric monomial q = x2·x3: as ρ vanishes on J₁₆, a₁g̃₁ ∉ J, so the direction is not
trivial (the deduction from `T3_rho_kills_J` is not formalised) -/
theorem T3_excess_nontrivial : ev rho (mul [(33792, 1)] (mul gt1 a1)) ≠ 0 := by decide +kernel

/-! ## 8. (T4) Q₀ = f₁h₁ lies in K -/

theorem Q0_monomial : Q0 = [(33, 1)] := by decide +kernel
/-- **ρ(Q₀·a₁·m) = 0 and ρ(Q₀·a₂·m) = 0** for the 84 monomials m of degree 6 -/
theorem T4_Q0_in_K : ∀ m ∈ mons 6, ev rho (mul Q0 (mul [(m, 1)] a1)) = 0 ∧ ev rho (mul Q0 (mul [(m, 1)] a2)) = 0 := by
  decide +kernel
/-- the same for every exponent vector of degree 6 -/
theorem T4_Q0_in_K_all (a b c e : Nat) (h : a + b + c + e = 6) :
    ev rho (mul Q0 (mul [(a + 32 * b + 1024 * c + 32768 * e, 1)] a1)) = 0
    ∧ ev rho (mul Q0 (mul [(a + 32 * b + 1024 * c + 32768 * e, 1)] a2)) = 0 :=
  T4_Q0_in_K _ (mem_mons 6 a b c e h)

/-! ## 9. (T5) the four second-order numbers -/

/-- ρ(Q₀·p) = ρ_Q(p) -/
theorem ev_Q0 (p : Poly) : ev rho (mul Q0 p) = ev rhoQ p := by
  rw [Q0_monomial, ev_mul]
  show 1 * ev (fun k => rho (33 + k)) p + 0 = ev rhoQ p
  have e : ev (fun k => rho (33 + k)) p = ev rhoQ p := rfl
  omega
theorem T5_kernel : nE rhoQ B2 gt1 = 0 ∧ nE rhoQ B1 gt2 = 0 ∧ nE rhoQ B0 gt1 - nE rhoQ B2 gt2 = A0
    ∧ -nE rhoQ B0 gt2 - nE rhoQ B1 gt1 = A0 := by
  decide +kernel
/-- **ρ(Q₀·N(B², g̃₁)) = 0, ρ(Q₀·N(B¹, g̃₂)) = 0,
ρ(Q₀·N(B⁰, g̃₁)) − ρ(Q₀·N(B², g̃₂)) = A₀ = −ρ(Q₀·N(B⁰, g̃₂)) − ρ(Q₀·N(B¹, g̃₁))** -/
theorem T5_numbers : ev rho (mul Q0 (N B2 gt1)) = 0 ∧ ev rho (mul Q0 (N B1 gt2)) = 0
    ∧ ev rho (mul Q0 (N B0 gt1)) - ev rho (mul Q0 (N B2 gt2)) = A0
    ∧ -ev rho (mul Q0 (N B0 gt2)) - ev rho (mul Q0 (N B1 gt1)) = A0 := by
  simp only [ev_Q0, ev_N]; exact T5_kernel
/-- **A₀ ≠ 0** -/
theorem A0_ne_zero : A0 ≠ 0 := by decide +kernel

/-! ## 10. (T6) every rational r ≠ 0 -/

/-- a_r = a₁ + r·a₂ -/
def aR (r : Rat) : QPoly := famA a1 a2 r
/-- G_r = g̃₁ − (1/r)·g̃₂ -/
def GR (r : Rat) : QPoly := famG gt1 gt2 r⁻¹
/-- B_r = B⁰ − (1/r)·B¹ + r·B² -/
def BR (r : Rat) : QVec := famB B0 B1 B2 r r⁻¹
/-- ρ with rational values -/
def rhoRat (n : Nat) : Rat := ((rho n : Int) : Rat)
/-- the second-order obstruction ρ(Q₀·N(B_r, G_r)) -/
def Ob (r : Rat) : Rat := qev rhoRat (qmul (toQ Q0) (qN (BR r) (GR r)))

theorem qev_Q0 (p : QPoly) : qev rhoRat (qmul (toQ Q0) p) = qev (fun n => ((rhoQ n : Int) : Rat)) p := by
  rw [Q0_monomial, qev_mul]
  show ((1 : Int) : Rat) * qev (fun k => ((rho (33 + k) : Int) : Rat)) p + 0 = qev (fun n => ((rhoQ n : Int) : Rat)) p
  have h1 : ((1 : Int) : Rat) = 1 := rfl
  have h2 : qev (fun k => ((rho (33 + k) : Int) : Rat)) p = qev (fun n => ((rhoQ n : Int) : Rat)) p := rfl
  rw [h1, h2]; grind
/-- **first order:** G_r·a_r = Σ_k F_k·(B_r)_k, i.e. (a₁ + r a₂)·G_r = B_r·∇F, for every rational r ≠ 0 -/
theorem T6_first_order (r : Rat) (hr : r ≠ 0) (m : Nat) :
    qcoeff (qmul (GR r) (aR r)) m = qcoeff (qdot (vtoQ dF) (BR r)) m :=
  first_order_general a1 a2 gt1 gt2 dF B0 B1 B2 T2_id0 T2_id1 T2_id2 r r⁻¹ (Rat.mul_inv_cancel r hr) m
/-- **second order:** ρ(Q₀·N(B_r, G_r)) = A₀·(1 + 1/r) for every rational r ≠ 0 -/
theorem T6_second_order (r : Rat) (hr : r ≠ 0) : Ob r = (A0 : Rat) * (1 + r⁻¹) := by
  have n := T5_kernel
  rw [Ob, qev_Q0]
  exact second_order_general gt1 gt2 B0 B1 B2 rhoQ A0 (by rw [ev_N]; exact n.1) (by rw [ev_N]; exact n.2.1)
    (by rw [ev_N, ev_N]; exact n.2.2.1) (by rw [ev_N, ev_N]; exact n.2.2.2) r r⁻¹ (Rat.mul_inv_cancel r hr)
/-- **the obstruction vanishes exactly for r = −1** -/
theorem T6_zero_iff (r : Rat) (hr : r ≠ 0) : Ob r = 0 ↔ r = -1 := by
  rw [T6_second_order r hr]; exact zero_iff_general A0 A0_ne_zero r hr
/-- the values of the factor 1 + 1/r at the r of the exact Python computation -/
theorem factor_values : (1 + (1 : Rat)⁻¹ = 2) ∧ (1 + (-1 : Rat)⁻¹ = 0) ∧ (1 + (2 : Rat)⁻¹ = 3 / 2) ∧ (1 + (3 : Rat)⁻¹ = 4 / 3)
    ∧ (1 + (1 / 2 : Rat)⁻¹ = 3) ∧ (1 + (-2 : Rat)⁻¹ = 1 / 2) ∧ (1 + (5 / 3 : Rat)⁻¹ = 8 / 5) := by
  decide +kernel
/-- **Main theorem.**  For every rational r ≠ 0, with G_r = g̃₁ − g̃₂/r and B_r = B⁰ − B¹/r + r·B²:
(a₁ + r a₂)·G_r = Σ_k (B_r)_k·F_k, and ρ(Q₀·N(B_r, G_r)) = A₀·(1 + 1/r) with A₀ ≠ 0; it is zero iff r = −1. -/
theorem main (r : Rat) (hr : r ≠ 0) :
    (∀ m, qcoeff (qmul (GR r) (aR r)) m = qcoeff (qdot (vtoQ dF) (BR r)) m)
    ∧ Ob r = (A0 : Rat) * (1 + r⁻¹) ∧ A0 ≠ 0 ∧ (Ob r = 0 ↔ r = -1) :=
  ⟨T6_first_order r hr, T6_second_order r hr, A0_ne_zero, T6_zero_iff r hr⟩

