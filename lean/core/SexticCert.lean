theorem qev_shift (Φ : Nat → Rat) (c : Nat) (a : Rat) (q : QPoly) :
    qev Φ (q.map fun t => (c + t.1, a * t.2)) = a * qev (fun n => Φ (c + n)) q := by
  induction q with
  | nil => simp [qev]
  | cons t q ih => simp only [List.map_cons, qev, ih]; grind
theorem qev_mul (Φ : Nat → Rat) (p q : QPoly) : qev Φ (qmul p q) = qB Φ p q := by
  induction p with
  | nil => rfl
  | cons s p ih =>
    have e : qmul (s :: p) q = (q.map fun t => (s.1 + t.1, s.2 * t.2)) ++ qmul p q := by simp [qmul]
    rw [e, qev_append, qev_shift, ih]; rfl
theorem qev_fun_add (f g : Nat → Rat) (p : QPoly) : qev (fun n => f n + g n) p = qev f p + qev g p := by
  induction p with
  | nil => show (0 : Rat) = 0 + 0; grind
  | cons t p ih => simp only [qev, ih]; grind
theorem qev_fun_smul (c : Rat) (f : Nat → Rat) (p : QPoly) : qev (fun n => c * f n) p = c * qev f p := by
  induction p with
  | nil => simp [qev]
  | cons t p ih => simp only [qev, ih]; grind
theorem qB_add_left (Φ : Nat → Rat) (p p' q : QPoly) : qB Φ (p ++ p') q = qB Φ p q + qB Φ p' q := qev_append _ p p'
theorem qB_smul_left (Φ : Nat → Rat) (c : Rat) (p q : QPoly) : qB Φ (qsmul c p) q = c * qB Φ p q := qev_smul _ c p
theorem qB_add_right (Φ : Nat → Rat) (p q q' : QPoly) : qB Φ p (q ++ q') = qB Φ p q + qB Φ p q' := by
  simp only [qB, qev_append, qev_fun_add]
theorem qB_smul_right (Φ : Nat → Rat) (c : Rat) (p q : QPoly) : qB Φ p (qsmul c q) = c * qB Φ p q := by
  simp only [qB, qev_smul, qev_fun_smul]
theorem qev_toQ (Φ : Nat → Int) (p : Poly) : qev (fun n => ((Φ n : Int) : Rat)) (toQ p) = ((ev Φ p : Int) : Rat) := by
  induction p with
  | nil => rfl
  | cons t p ih =>
    simp only [toQ, List.map_cons, qev, ev, Rat.intCast_add, Rat.intCast_mul] at ih ⊢
