namespace SexticCert

/-! ## 1. Polynomials in x₀..x₃ with integer coefficients: specification level -/

/-- A polynomial: a list of terms (monomial code, coefficient); the code of x₀^a x₁^b x₂^c x₃^d is
a + 32·b + 32²·c + 32³·d.  The list is NOT assumed normalised: the polynomial is the sum of its terms. -/
abbrev Poly := List (Nat × Int)
/-- four polynomials (only the entries 0..3 are used) -/
abbrev Vec := Nat → Poly

/-- p + q -/
def add (p q : Poly) : Poly := p ++ q
/-- c·p -/
def smul (c : Int) (p : Poly) : Poly := p.map fun t => (t.1, c * t.2)
/-- p·q: all products of pairs of terms; monomials multiply by adding codes -/
def mul (p q : Poly) : Poly := p.flatMap fun s => q.map fun t => (s.1 + t.1, s.2 * t.2)
/-- the coefficient of the monomial with code `m`: sum over all terms with that code -/
def coeff : Poly → Nat → Int
  | [], _ => 0
  | t :: p, m => if t.1 = m then t.2 + coeff p m else coeff p m
/-- two term lists represent the same polynomial -/
def SamePoly (p q : Poly) : Prop := ∀ m, coeff p m = coeff q m
/-- a linear functional given by its values Φ(m) on monomials, applied to a polynomial -/
def ev (Φ : Nat → Int) : Poly → Int
  | [] => 0
  | t :: p => t.2 * Φ t.1 + ev Φ p
/-- exponent of x_k in the monomial with code `m` -/
def expo (m k : Nat) : Nat := m / 32 ^ k % 32
def degree (m : Nat) : Nat := expo m 0 + expo m 1 + expo m 2 + expo m 3
/-- ∂p/∂x_k -/
def deriv (k : Nat) (p : Poly) : Poly :=
  (p.filter fun t => expo t.1 k != 0).map fun t => (t.1 - 32 ^ k, (expo t.1 k : Int) * t.2)
/-- Σ_k B_k·C_k -/
def dot (B C : Vec) : Poly := add (mul (B 0) (C 0)) (add (mul (B 1) (C 1)) (add (mul (B 2) (C 2)) (mul (B 3) (C 3))))
/-- the gradient -/
def grad (G : Poly) : Vec := fun k => deriv k G
/-- the divergence Σ_k ∂B_k/∂x_k -/
def divg (B : Vec) : Poly := add (deriv 0 (B 0)) (add (deriv 1 (B 1)) (add (deriv 2 (B 2)) (deriv 3 (B 3))))
/-- N(B, G) = Σ_k B_k·∂G/∂x_k − G·Σ_k ∂B_k/∂x_k -/
def N (B : Vec) (G : Poly) : Poly := add (dot B (grad G)) (smul (-1) (mul G (divg B)))
/-- codes of the monomials of degree d -/
def mons (d : Nat) : List Nat :=
  (List.range (d + 1)).flatMap fun a => (List.range (d + 1 - a)).flatMap fun b =>
    (List.range (d + 1 - a - b)).map fun c => a + 32 * b + 1024 * c + 32768 * (d - a - b - c)
def isHomog (d : Nat) (p : Poly) : Bool := p.all fun t => t.1 < 32 ^ 4 && degree t.1 == d

/-! ## 2. Normalising operations (used for the kernel computations) and their soundness -/

/-- merge of two term lists sorted by code; coefficients of equal codes are added -/
def mergeF : Nat → Poly → Poly → Poly
  | 0, p, q => p ++ q
  | _ + 1, [], q => q
  | _ + 1, s :: p, [] => s :: p
  | n + 1, s :: p, t :: q =>
    if s.1 < t.1 then s :: mergeF n p (t :: q)
    else if t.1 < s.1 then t :: mergeF n (s :: p) q
    else (s.1, s.2 + t.2) :: mergeF n p q
def FUEL : Nat := 1000000
def addN (p q : Poly) : Poly := mergeF FUEL p q
def mulN (p q : Poly) : Poly := p.foldr (fun s acc => addN (q.map fun t => (s.1 + t.1, s.2 * t.2)) acc) []
def clean (p : Poly) : Poly := p.filter fun t => t.2 != 0
def isZero (p : Poly) : Bool := p.all fun t => t.2 == 0
/-- Σ c·p·q over a list of triples (c, p, q) -/
def comb : List (Int × Poly × Poly) → Poly
  | [] => []
  | x :: L => add (smul x.1 (mul x.2.1 x.2.2)) (comb L)
def combN : List (Int × Poly × Poly) → Poly
  | [] => []
  | x :: L => addN (smul x.1 (mulN x.2.1 x.2.2)) (combN L)
def subN (p q : Poly) : Poly := addN p (smul (-1) q)
def minorN (p q : Poly) (i j : Nat) : Poly := subN (mulN (deriv i p) (deriv j q)) (mulN (deriv j p) (deriv i q))
/-- det of the Jacobian matrix of (p₁,p₂,p₃,p₄): Laplace expansion along the first two rows -/
def jacN (p1 p2 p3 p4 : Poly) : Poly :=
  clean (addN (mulN (minorN p1 p2 0 1) (minorN p3 p4 2 3))
    (addN (smul (-1) (mulN (minorN p1 p2 0 2) (minorN p3 p4 1 3)))
    (addN (mulN (minorN p1 p2 0 3) (minorN p3 p4 1 2))
    (addN (mulN (minorN p1 p2 1 2) (minorN p3 p4 0 3))
    (addN (smul (-1) (mulN (minorN p1 p2 1 3) (minorN p3 p4 0 2)))
      (mulN (minorN p1 p2 2 3) (minorN p3 p4 0 1)))))))
def nth {α : Type} (d : α) : List α → Nat → α
  | [], _ => d
  | x :: _, 0 => x
  | _ :: l, n + 1 => nth d l n
def lookup (T : List (List (List Int))) (m : Nat) : Int := nth 0 (nth [] (nth [] T (expo m 0)) (expo m 1)) (expo m 2)
def ev2 (Φ : Nat → Int) (p q : Poly) : Int := ev (fun n => ev (fun k => Φ (n + k)) q) p
def nE (Φ : Nat → Int) (B : Vec) (G : Poly) : Int :=
  ev2 Φ (B 0) (deriv 0 G) + ev2 Φ (B 1) (deriv 1 G) + ev2 Φ (B 2) (deriv 2 G) + ev2 Φ (B 3) (deriv 3 G)
    - (ev2 Φ G (deriv 0 (B 0)) + ev2 Φ G (deriv 1 (B 1)) + ev2 Φ G (deriv 2 (B 2)) + ev2 Φ G (deriv 3 (B 3)))
def delta (m n : Nat) : Int := if n = m then 1 else 0

theorem coeff_append (p q : Poly) (m : Nat) : coeff (p ++ q) m = coeff p m + coeff q m := by
  induction p with
  | nil => simp [coeff]
  | cons t p ih => simp only [List.cons_append, coeff]; split <;> omega
theorem coeff_smul (c : Int) (p : Poly) (m : Nat) : coeff (smul c p) m = c * coeff p m := by
  induction p with
  | nil => simp [smul, coeff]
  | cons t p ih =>
    simp only [smul, List.map_cons, coeff] at ih ⊢
    split <;> simp [ih, Int.mul_add]
theorem coeff_eq_ev (p : Poly) (m : Nat) : coeff p m = ev (delta m) p := by
  induction p with
  | nil => rfl
  | cons t p ih => by_cases h : t.1 = m <;> simp [coeff, ev, delta, h, ih]
theorem coeff_mergeF (n : Nat) : ∀ (p q : Poly) (m : Nat), coeff (mergeF n p q) m = coeff p m + coeff q m := by
  induction n with
  | zero => intro p q m; simp [mergeF, coeff_append]
  | succ n ih =>
    intro p q m
    cases p with
    | nil => simp [mergeF, coeff]
    | cons s p =>
      cases q with
      | nil => simp [mergeF, coeff]
      | cons t q =>
        simp only [mergeF]
        split
        · simp only [coeff, ih]; repeat' split
          all_goals omega
        · split
          · simp only [coeff, ih]; repeat' split
            all_goals omega
          · simp only [coeff, ih]; repeat' split
            all_goals omega
theorem coeff_mulN (p q : Poly) (m : Nat) : coeff (mulN p q) m = coeff (mul p q) m := by
  induction p with
  | nil => rfl
  | cons s p ih =>
    have e1 : mulN (s :: p) q = addN (q.map fun t => (s.1 + t.1, s.2 * t.2)) (mulN p q) := rfl
    have e2 : mul (s :: p) q = (q.map fun t => (s.1 + t.1, s.2 * t.2)) ++ mul p q := by simp [mul]
    rw [e1, e2, addN, coeff_mergeF, coeff_append, ih]
theorem coeff_combN (L : List (Int × Poly × Poly)) (m : Nat) : coeff (combN L) m = coeff (comb L) m := by
  induction L with
  | nil => rfl
  | cons x L ih => simp only [combN, comb, add, addN, coeff_mergeF, coeff_append, coeff_smul, coeff_mulN, ih]
theorem coeff_zero_of_isZero (p : Poly) (h : isZero p = true) (m : Nat) : coeff p m = 0 := by
  induction p with
  | nil => rfl
  | cons t p ih =>
    simp only [isZero, List.all_cons, Bool.and_eq_true, beq_iff_eq] at h
    have ih' := ih h.2
    simp only [coeff, h.1, ih']; split <;> rfl
/-- the kernel test `isZero (combN L) = true` proves Σ c·p·q = 0 -/
theorem comb_zero (L : List (Int × Poly × Poly)) (h : isZero (combN L) = true) (m : Nat) : coeff (comb L) m = 0 := by
  rw [← coeff_combN]; exact coeff_zero_of_isZero _ h m
theorem one_mul (p : Poly) : mul [(0, 1)] p = p := by simp [mul]
theorem coeff_nil (m : Nat) : coeff [] m = 0 := rfl
/-- `mons d` contains every monomial of degree d -/
theorem mem_mons (d a b c e : Nat) (h : a + b + c + e = d) : a + 32 * b + 1024 * c + 32768 * e ∈ mons d := by
  subst h
  simp only [mons, List.mem_flatMap, List.mem_map, List.mem_range]
  refine ⟨a, by omega, b, by omega, c, by omega, ?_⟩
  omega

theorem ev_append (Φ : Nat → Int) (p q : Poly) : ev Φ (p ++ q) = ev Φ p + ev Φ q := by
  induction p with
  | nil => simp [ev]
  | cons t p ih => simp only [List.cons_append, ev, ih]; omega
theorem ev_smul (Φ : Nat → Int) (c : Int) (p : Poly) : ev Φ (smul c p) = c * ev Φ p := by
  induction p with
  | nil => simp [smul, ev]
  | cons t p ih =>
    simp only [smul, List.map_cons, ev] at ih ⊢
    rw [ih, Int.mul_add, Int.mul_assoc]
theorem ev_shift (Φ : Nat → Int) (c : Nat) (a : Int) (q : Poly) :
    ev Φ (q.map fun t => (c + t.1, a * t.2)) = a * ev (fun n => Φ (c + n)) q := by
  induction q with
  | nil => simp [ev]
  | cons t q ih => simp only [List.map_cons, ev, ih, Int.mul_add, Int.mul_assoc]
theorem ev_mul (Φ : Nat → Int) (p q : Poly) : ev Φ (mul p q) = ev2 Φ p q := by
  induction p with
  | nil => rfl
  | cons s p ih =>
    have e : mul (s :: p) q = (q.map fun t => (s.1 + t.1, s.2 * t.2)) ++ mul p q := by simp [mul]
    rw [e, ev_append, ev_shift, ih]; rfl
theorem ev_fun_add (f g : Nat → Int) (p : Poly) : ev (fun n => f n + g n) p = ev f p + ev g p := by
  induction p with
  | nil => rfl
  | cons t p ih => simp only [ev, ih, Int.mul_add]; omega
theorem ev2_append_right (Φ : Nat → Int) (p q q' : Poly) : ev2 Φ p (q ++ q') = ev2 Φ p q + ev2 Φ p q' := by
  simp only [ev2, ev_append, ev_fun_add]
/-- Φ(N(B, G)) is the number computed by `nE` -/
theorem ev_N (Φ : Nat → Int) (B : Vec) (G : Poly) : ev Φ (N B G) = nE Φ B G := by
  simp only [N, dot, grad, divg, add, ev_append, ev_smul, ev_mul, ev2_append_right, nE]; omega

/-! ## 3. Rational coefficients: specification level for the statements with a rational parameter -/

abbrev QPoly := List (Nat × Rat)
abbrev QVec := Nat → QPoly
def toQ (p : Poly) : QPoly := p.map fun t => (t.1, (t.2 : Rat))
def vtoQ (B : Vec) : QVec := fun k => toQ (B k)
def qadd (p q : QPoly) : QPoly := p ++ q
def qsmul (c : Rat) (p : QPoly) : QPoly := p.map fun t => (t.1, c * t.2)
def qmul (p q : QPoly) : QPoly := p.flatMap fun s => q.map fun t => (s.1 + t.1, s.2 * t.2)
def qcoeff : QPoly → Nat → Rat
  | [], _ => 0
  | t :: p, m => if t.1 = m then t.2 + qcoeff p m else qcoeff p m
def qev (Φ : Nat → Rat) : QPoly → Rat
  | [] => 0
  | t :: p => t.2 * Φ t.1 + qev Φ p
def qderiv (k : Nat) (p : QPoly) : QPoly :=
  (p.filter fun t => expo t.1 k != 0).map fun t => (t.1 - 32 ^ k, ((expo t.1 k : Int) : Rat) * t.2)
def qdot (B C : QVec) : QPoly := qadd (qmul (B 0) (C 0)) (qadd (qmul (B 1) (C 1)) (qadd (qmul (B 2) (C 2)) (qmul (B 3) (C 3))))
def qgrad (G : QPoly) : QVec := fun k => qderiv k G
def qdivg (B : QVec) : QPoly := qadd (qderiv 0 (B 0)) (qadd (qderiv 1 (B 1)) (qadd (qderiv 2 (B 2)) (qderiv 3 (B 3))))
def qN (B : QVec) (G : QPoly) : QPoly := qadd (qdot B (qgrad G)) (qsmul (-1) (qmul G (qdivg B)))
/-- a₁ + r·a₂ -/
def famA (a1 a2 : Poly) (r : Rat) : QPoly := qadd (toQ a1) (qsmul r (toQ a2))
/-- G = g̃₁ − s·g̃₂  (s = 1/r) -/
def famG (g1 g2 : Poly) (s : Rat) : QPoly := qadd (toQ g1) (qsmul (-s) (toQ g2))
/-- B = B⁰ − s·B¹ + r·B²  (s = 1/r) -/
def famB (B0 B1 B2 : Vec) (r s : Rat) : QVec :=
  fun k => qadd (toQ (B0 k)) (qadd (qsmul (-s) (toQ (B1 k))) (qsmul r (toQ (B2 k))))
def qB (Φ : Nat → Rat) (p q : QPoly) : Rat := qev (fun n => qev (fun k => Φ (n + k)) q) p

theorem qev_append (Φ : Nat → Rat) (p q : QPoly) : qev Φ (p ++ q) = qev Φ p + qev Φ q := by
  induction p with
  | nil => show qev Φ q = 0 + qev Φ q; grind
  | cons t p ih => simp only [List.cons_append, qev, ih]; grind
theorem qev_smul (Φ : Nat → Rat) (c : Rat) (p : QPoly) : qev Φ (qsmul c p) = c * qev Φ p := by
  induction p with
  | nil => simp [qsmul, qev]
  | cons t p ih =>
    simp only [qsmul, List.map_cons, qev] at ih ⊢
