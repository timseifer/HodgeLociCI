/-- **injectivity of q ↦ (q·G²)_squarefree:** if q·G² ∈ J₈ for the three cubics of `rank1`, then
q = 0 (q = Σ c(m)·m, the sum over the 45 squarefree quadric monomials). -/
theorem P1_q_unique (c : Nat → Int)
    (h : ∀ G ∈ rank1, sqfreePart (mul (quadForm c) (mul G G)) = zero45) :
    ∀ m ∈ quadMons, c m = 0 := by
  have hA := sqfreePart_zero (h rankA1 (by simp [rank1]))
  have hB := sqfreePart_zero (h rankB1 (by simp [rank1]))
  have hC := sqfreePart_zero (h rankC1 (by simp [rank1]))
  have e0 := hA 0x1111101011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_0, quadMons_eq] at e0
  simp [dotL] at e0
  have e1 := hA 0x1111011011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_1, quadMons_eq] at e1
  simp [dotL] at e1
  have e2 := hA 0x1110111011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_2, quadMons_eq] at e2
  simp [dotL] at e2
  have e3 := hA 0x1101111011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_3, quadMons_eq] at e3
  simp [dotL] at e3
  have e4 := hA 0x1011111011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_4, quadMons_eq] at e4
  simp [dotL] at e4
  have e5 := hA 0x111111011 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_5, quadMons_eq] at e5
