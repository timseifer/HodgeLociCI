/-- Λ(a₁·m) = Λ(a₂·m) = 0 for every cubic monomial m (kernel computation, 440 cases) -/
theorem functional_kills_aS3 : ∀ m ∈ cubicMons,
    Lam (mul a1 [(m, 1)]) = 0 ∧ Lam (mul a2 [(m, 1)]) = 0 := by
  intro m hm
  simp only [cubicMons, List.mem_flatMap, List.mem_range] at hm
  obtain ⟨i, hi, hmi⟩ := hm
  have hcases : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 ∨ i = 8 ∨ i = 9 := by omega
  rcases hcases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact functional_kills_0 m hmi
  · exact functional_kills_1 m hmi
  · exact functional_kills_2 m hmi
  · exact functional_kills_3 m hmi
  · exact functional_kills_4 m hmi
  · exact functional_kills_5 m hmi
  · exact functional_kills_6 m hmi
  · exact functional_kills_7 m hmi
  · exact functional_kills_8 m hmi
  · exact functional_kills_9 m hmi
