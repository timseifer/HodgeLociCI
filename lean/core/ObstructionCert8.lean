  rw [quadForm, coeff_genForm, P1_row_6, quadMons_eq] at e6
  simp [dotL] at e6
  have e7 := hA 0x1111010111 (by decide +kernel)
  rw [quadForm, coeff_genForm, P1_row_7, quadMons_eq] at e7
