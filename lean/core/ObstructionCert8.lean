theorem LamMons_firstSq : ∀ m ∈ LamMons, firstSq m = 10 := by decide +kernel

/-- two term lists represent the same polynomial -/
def SamePoly (p q : Poly Int) : Prop := ∀ m, coeff p m = coeff q m

theorem Lam_eq (p : Poly Int) : Lam p =
    coeff p 0x1111111100 + (coeff p 0x1111111010 + (coeff p 0x1111111001 + 0)) := rfl
theorem Lam_congr {p q : Poly Int} (h : SamePoly p q) : Lam p = Lam q := by
  simp only [Lam_eq, h _]
theorem Lam_add (p q : Poly Int) : Lam (add p q) = Lam p + Lam q := by
  simp only [Lam_eq, coeff_add]; omega
theorem Lam_smul (c : Int) (p : Poly Int) : Lam (smul c p) = c * Lam p := by
  simp only [Lam_eq, coeff_smul, Int.mul_add, Int.mul_zero]
theorem coeff_mul_nil (p : Poly Int) (m : Nat) : coeff (mul p []) m = 0 := by
  induction p with
  | nil => rfl
  | cons s p ih => simpa [mul, coeff] using ih
theorem coeff_mul_cons (p : Poly Int) (t : Nat × Int) (h : Poly Int) (m : Nat) :
    coeff (mul p (t :: h)) m = coeff (mul p [t]) m + coeff (mul p h) m := by
  induction p with
  | nil => rfl
  | cons s p ih =>
    simp only [mul, List.flatMap_cons, List.map_cons, List.map_nil, List.cons_append, List.nil_append,
      coeff, coeff_append] at ih ⊢
    split <;> omega
theorem coeff_mul_single (p : Poly Int) (n : Nat) (c : Int) (m : Nat) :
    coeff (mul p [(n, c)]) m = c * coeff (mul p [(n, 1)]) m := by
  induction p with
  | nil => simp [mul, coeff]
  | cons s p ih =>
    simp only [mul, List.flatMap_cons, List.map_cons, List.map_nil, List.cons_append, List.nil_append,
      coeff] at ih ⊢
    split
    · rw [ih, Int.mul_add, Int.mul_one, Int.mul_comm s.2 c]
    · exact ih
theorem mul_add_left (p q h : Poly Int) : mul (add p q) h = add (mul p h) (mul q h) := by
  simp [mul, add]
theorem mul_smul_left (c : Int) (p h : Poly Int) : mul (smul c p) h = smul c (mul p h) := by
  simp [mul, smul, List.flatMap_map, List.map_flatMap, Function.comp_def, Int.mul_assoc]
/-- Λ(p·H) = 0 for every cubic H, if Λ(p·m) = 0 for the cubic monomials m -/
theorem Lam_mul_cubic (p : Poly Int) (hp : ∀ m ∈ cubicMons, Lam (mul p [(m, 1)]) = 0)
    (H : Poly Int) (hH : ∀ t ∈ H, t.1 ∈ cubicMons) : Lam (mul p H) = 0 := by
  induction H with
  | nil => simp [Lam_eq, coeff_mul_nil]
  | cons t H ih =>
    have h1 : Lam (mul p [t]) = 0 := by
      have e : Lam (mul p [(t.1, t.2)]) = t.2 * Lam (mul p [(t.1, 1)]) := by
        simp only [Lam_eq, coeff_mul_single p t.1 t.2, Int.mul_add, Int.mul_zero]
      rw [show [t] = [(t.1, t.2)] from rfl, e, hp t.1 (hH t (List.mem_cons_self ..)), Int.mul_zero]
    have h2 : Lam (mul p H) = 0 := ih fun t' ht' => hH t' (List.mem_cons_of_mem _ ht')
    have e : Lam (mul p (t :: H)) = Lam (mul p [t]) + Lam (mul p H) := by
      simp only [Lam_eq, coeff_mul_cons p t H]; omega
    rw [e, h1, h2]; rfl
/-- **Λ kills (a₁+λa₂)·S₃:** for every integer λ and every cubic H. -/
theorem Lam_kills_aS3 (lam : Int) (H : Poly Int) (hH : ∀ t ∈ H, t.1 ∈ cubicMons) :
    Lam (mul (aLam lam) H) = 0 := by
  apply Lam_mul_cubic _ _ H hH
  intro m hm
  have h := functional_kills_aS3 m hm
  rw [aLam, ofInt_int, ofInt_int, mul_add_left, mul_smul_left, Lam_add, Lam_smul, h.1, h.2]
  simp
theorem coeff_eq_zero (K : Poly Int) (m : Nat) (h : ∀ t ∈ K, t.1 ≠ m) : coeff K m = 0 := by
  induction K with
  | nil => rfl
  | cons t K ih =>
    have ht : t.1 ≠ m := h t (List.mem_cons_self ..)
    have hK : coeff K m = 0 := ih fun t' ht' => h t' (List.mem_cons_of_mem _ ht')
    simp [coeff, ht, hK]
/-- **Λ kills J₈:** Λ(K) = 0 if no monomial of K is squarefree. -/
theorem Lam_kills_J (K : Poly Int) (hK : ∀ t ∈ K, firstSq t.1 < 10) : Lam K = 0 := by
  have key : ∀ m ∈ LamMons, coeff K m = 0 := by
    intro m hm
    apply coeff_eq_zero
    intro t ht e
    have h1 := hK t ht
    rw [e, LamMons_firstSq m hm] at h1
    omega
  rw [Lam_eq, key 0x1111111100 (by simp [LamMons]), key 0x1111111010 (by simp [LamMons]),
    key 0x1111111001 (by simp [LamMons])]
  rfl

/-- **Non-membership (the obstruction is not zero).**  For an integer λ ∉ {0, 1} the octic
N3((a₁+λa₂)·G_λ, G_λ) is NOT of the form (a₁+λa₂)·H + K with H a cubic (all monomials of H cubic) and
K ∈ J₈ (no monomial of K squarefree): Λ vanishes on every such polynomial, but
Λ(N3(…)) = obLam λ = 4λ(λ-1) ≠ 0. -/
theorem obstruction_not_in_ideal (lam : Int) (h0 : lam ≠ 0) (h1 : lam ≠ 1) (H K : Poly Int)
    (hH : ∀ t ∈ H, t.1 ∈ cubicMons) (hK : ∀ t ∈ K, firstSq t.1 < 10) :
    ¬ SamePoly (N3 (mul (aLam lam) (Glam lam)) (Glam lam)) (add (mul (aLam lam) H) K) := by
  intro hsame
  have e : obLam lam = Lam (add (mul (aLam lam) H) K) := Lam_congr hsame
  rw [Lam_add, Lam_kills_aS3 lam H hH, Lam_kills_J K hK] at e
  rcases (obstruction_int_zero_iff lam).mp e with h | h
  · exact h0 h
  · exact h1 h

/-! ## The two 4-planes lie on X and meet in a line (elementary form) -/

/-- the Fermat cubic in 10 variables -/
def fermat (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 : Int) : Int :=
  x0 ^ 3 + x1 ^ 3 + x2 ^ 3 + x3 ^ 3 + x4 ^ 3 + x5 ^ 3 + x6 ^ 3 + x7 ^ 3 + x8 ^ 3 + x9 ^ 3
/-- P₁ ⊂ X (integer points) -/
theorem P1_on_fermat (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 : Int)
    (h01 : x0 + x1 = 0) (h23 : x2 + x3 = 0) (h45 : x4 + x5 = 0) (h67 : x6 + x7 = 0) (h89 : x8 + x9 = 0) :
    fermat x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 = 0 := by
  unfold fermat; grind
/-- P₂ ⊂ X (integer points) -/
theorem P2_on_fermat (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 : Int)
    (h05 : x0 + x5 = 0) (h12 : x1 + x2 = 0) (h34 : x3 + x4 = 0) (h69 : x6 + x9 = 0) (h78 : x7 + x8 = 0) :
    fermat x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 = 0 := by
  unfold fermat; grind
/-- P₁ ∩ P₂ ⊂ {(s,-s,s,-s,s,-s,t,-t,t,-t)}: the five equations of P₁ and three of those of P₂ already
force this (the remaining two, x₀+x₅ = 0 and x₆+x₉ = 0, then hold automatically, `meeting_line`). -/
theorem planes_meet (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 : Int)
    (h01 : x0 + x1 = 0) (h23 : x2 + x3 = 0) (h45 : x4 + x5 = 0) (h67 : x6 + x7 = 0) (h89 : x8 + x9 = 0)
    (h12 : x1 + x2 = 0) (h34 : x3 + x4 = 0) (h78 : x7 + x8 = 0) :
    x1 = -x0 ∧ x2 = x0 ∧ x3 = -x0 ∧ x4 = x0 ∧ x5 = -x0 ∧ x7 = -x6 ∧ x8 = x6 ∧ x9 = -x6 := by omega
/-- every point (s,-s,s,-s,s,-s,t,-t,t,-t) satisfies all ten equations: the planes meet in a line -/
theorem meeting_line (s t : Int) :
    s + -s = 0 ∧ s + -s = 0 ∧ s + -s = 0 ∧ t + -t = 0 ∧ t + -t = 0
      ∧ s + -s = 0 ∧ -s + s = 0 ∧ -s + s = 0 ∧ t + -t = 0 ∧ -t + t = 0 := by
  omega

