/-- **zero and unique:** for a quadric q = Σ c(m)·m,
`N3(a1·G, G) - 3·q·G² ∈ J₈` for the three cubics G of `rank1`  ⟺  q = 0. -/
theorem P1_correction_unique (c : Nat → Int) :
    (∀ G ∈ rank1, sqfreePart (sub (N3 (mul a1 G) G) (smul 3 (mul (quadForm c) (mul G G)))) = zero45)
      ↔ (∀ m ∈ quadMons, c m = 0) := by
  constructor
  · intro h
    apply P1_q_unique c
    intro G hG
    apply sqfreePart_zero_of
    intro T hT
    have h1 := sqfreePart_zero (h G hG) T hT
    have h2 := sqfreePart_zero (P1_correction_zero_rank G hG) T hT
    rw [coeff_sub, coeff_smul, h2] at h1
    omega
  · intro hc G hG
    apply sqfreePart_zero_of
    intro T hT
    have h2 := sqfreePart_zero (P1_correction_zero_rank G hG) T hT
    have h3 : coeff (mul (quadForm c) (mul G G)) T = 0 := by
      rw [quadForm, coeff_genForm]
      apply dotL_zero
      intro x hx
      rcases List.mem_map.mp hx with ⟨m, hm, rfl⟩
      exact hc m hm
    rw [coeff_sub, coeff_smul, h2, h3]
    rfl


/-! ## Correction term for the plane P2 = {x0+x5 = x1+x2 = x3+x4 = x6+x9 = x7+x8 = 0}: zero, and unique -/

/-- (x0 + x5)·(x1x2 + x3x4 + x6x9 + x7x8) -/
def rankA2 : Poly Int := vanishing 0 5 [(0x110, 1), (0x11000, 1), (0x1001000000, 1), (0x110000000, 1)]
/-- (x1 + x2)·(x0x5 + x3x4 + x6x9 + x7x8) -/
def rankB2 : Poly Int := vanishing 1 2 [(0x100001, 1), (0x11000, 1), (0x1001000000, 1), (0x110000000, 1)]
/-- (x3 + x4)·(x0x5 + x1x2 + x6x9 + x7x8) -/
def rankC2 : Poly Int := vanishing 3 4 [(0x100001, 1), (0x110, 1), (0x1001000000, 1), (0x110000000, 1)]
/-- the three cubics used for uniqueness of q -/
def rank2 : List (Poly Int) := [rankA2, rankB2, rankC2]
/-- further cubics vanishing on P2, each (xᵢ + xⱼ)·(quadric) with (i,j) a pair of the matching:
  (x6 + x9)·(x0x5 + x1x2 + x3x4 + x7x8)
  (x7 + x8)·(x0x5 + x1x2 + x3x4 + x6x9)
  (x0 + x5)·(x1x3 + x4x6 + x7x9)
  (x1 + x2)·(x0x4 + x5x7 - 2x8^2)
  (x3 + x4)·(x0x2 + 3x5x6 + x3x9)
  (x7 + x8)·(x7^2 + x0x1 - x2x6 + 2x4x9) -/
def more2 : List (Poly Int) :=
  [vanishing 6 9 [(0x100001, 1), (0x110, 1), (0x11000, 1), (0x110000000, 1)],
   vanishing 7 8 [(0x100001, 1), (0x110, 1), (0x11000, 1), (0x1001000000, 1)],
   vanishing 0 5 [(0x1010, 1), (0x1010000, 1), (0x1010000000, 1)],
   vanishing 1 2 [(0x10001, 1), (0x10100000, 1), (0x200000000, -2)],
   vanishing 3 4 [(0x101, 1), (0x1100000, 3), (0x1000001000, 1)],
   vanishing 7 8 [(0x20000000, 1), (0x11, 1), (0x1000100, -1), (0x1000010000, 2)]]
/-- a sum of such cubics (it tests cross terms of the quadratic map G ↦ N3(a2·G, G)) -/
def mixed2 : List (Poly Int) :=
  [add (vanishing 0 5 [(0x10010, 1), (0x200, 1)])
      (add (vanishing 6 9 [(0x10000001, 1), (0x100001000, -1)])
      (vanishing 7 8 [(0x1000010, 1), (0x1000000100, 2)]))]
/-- all test cubics for P2 -/
def tests2 : List (Poly Int) := rank2 ++ more2 ++ mixed2

/-- every test cubic is homogeneous of degree 3 -/
theorem P2_tests_cubic : ∀ G ∈ tests2, isHomog 3 G = true := by decide +kernel
theorem P2_first_order_rank_aux : ∀ G ∈ rank2, sqfreePart (sqTerms (mul a2 G)) = zero45 := by decide +kernel
theorem P2_first_order_rank : ∀ G ∈ rank2, sqfreePart (mul a2 G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_first_order_rank_aux G h
theorem P2_first_order_more_aux : ∀ G ∈ more2, sqfreePart (sqTerms (mul a2 G)) = zero45 := by decide +kernel
theorem P2_first_order_more : ∀ G ∈ more2, sqfreePart (mul a2 G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_first_order_more_aux G h
theorem P2_first_order_mixed_aux : ∀ G ∈ mixed2, sqfreePart (sqTerms (mul a2 G)) = zero45 := by decide +kernel
theorem P2_first_order_mixed : ∀ G ∈ mixed2, sqfreePart (mul a2 G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_first_order_mixed_aux G h
/-- **first order:** a2·G ∈ J₈ for every test cubic G. -/
theorem P2_tests_first_order : ∀ G ∈ tests2, sqfreePart (mul a2 G) = zero45 := by
  intro G h
  simp only [tests2, List.mem_append] at h
  rcases h with (h | h) | h
  · exact P2_first_order_rank G h
  · exact P2_first_order_more G h
  · exact P2_first_order_mixed G h
theorem P2_correction_zero_rank_aux : ∀ G ∈ rank2, sqfreePart (sqTerms (N3 (mul a2 G) G)) = zero45 := by decide +kernel
theorem P2_correction_zero_rank : ∀ G ∈ rank2, sqfreePart (N3 (mul a2 G) G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_correction_zero_rank_aux G h
theorem P2_correction_zero_more_aux : ∀ G ∈ more2, sqfreePart (sqTerms (N3 (mul a2 G) G)) = zero45 := by decide +kernel
theorem P2_correction_zero_more : ∀ G ∈ more2, sqfreePart (N3 (mul a2 G) G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_correction_zero_more_aux G h
theorem P2_correction_zero_mixed_aux : ∀ G ∈ mixed2, sqfreePart (sqTerms (N3 (mul a2 G) G)) = zero45 := by decide +kernel
theorem P2_correction_zero_mixed : ∀ G ∈ mixed2, sqfreePart (N3 (mul a2 G) G) = zero45 := by
  intro G h; rw [sqfreePart_filter]; exact P2_correction_zero_mixed_aux G h
/-- **correction term zero:** N3(a2·G, G) ∈ J₈ for every test cubic G, i.e. q = 0 solves
`N3(a2·G, G) - 3·q·G² ∈ J₈`. -/
theorem P2_correction_zero : ∀ G ∈ tests2, sqfreePart (N3 (mul a2 G) G) = zero45 := by
  intro G h
  simp only [tests2, List.mem_append] at h
  rcases h with (h | h) | h
  · exact P2_correction_zero_rank G h
  · exact P2_correction_zero_more G h
  · exact P2_correction_zero_mixed G h

