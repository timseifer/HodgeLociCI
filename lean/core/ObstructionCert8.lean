/-- **zero and unique:** for a quadric q = Σ c(m)·m,
`N3(a2·G, G) - 3·q·G² ∈ J₈` for the three cubics G of `rank2`  ⟺  q = 0. -/
theorem P2_correction_unique (c : Nat → Int) :
    (∀ G ∈ rank2, sqfreePart (sub (N3 (mul a2 G) G) (smul 3 (mul (quadForm c) (mul G G)))) = zero45)
      ↔ (∀ m ∈ quadMons, c m = 0) := by
  constructor
  · intro h
    apply P2_q_unique c
    intro G hG
    apply sqfreePart_zero_of
    intro T hT
    have h1 := sqfreePart_zero (h G hG) T hT
    have h2 := sqfreePart_zero (P2_correction_zero_rank G hG) T hT
    rw [coeff_sub, coeff_smul, h2] at h1
    omega
  · intro hc G hG
    apply sqfreePart_zero_of
    intro T hT
    have h2 := sqfreePart_zero (P2_correction_zero_rank G hG) T hT
    have h3 : coeff (mul (quadForm c) (mul G G)) T = 0 := by
      rw [quadForm, coeff_genForm]
      apply dotL_zero
      intro x hx
      rcases List.mem_map.mp hx with ⟨m, hm, rfl⟩
      exact hc m hm
    rw [coeff_sub, coeff_smul, h2, h3]
    rfl

/-! ## The functional Λ and the non-membership statement -/

/-- the cubic monomials xᵢxⱼx_k with i ≤ j ≤ k, for fixed i -/
def cubicsFrom (i : Nat) : List Nat :=
  (List.range 10).flatMap fun j => (List.range 10).filterMap fun k =>
    if i ≤ j ∧ j ≤ k then some (16 ^ i + 16 ^ j + 16 ^ k) else none
/-- the 220 cubic monomials xᵢxⱼx_k, i ≤ j ≤ k -/
def cubicMons : List Nat := (List.range 10).flatMap cubicsFrom
theorem cubicMons_length : cubicMons.length = 220 := by decide +kernel
theorem functional_kills_0 : ∀ m ∈ cubicsFrom 0,
    Lam (mul a1 [(m, 1)]) = 0 ∧ Lam (mul a2 [(m, 1)]) = 0 := by decide +kernel
theorem functional_kills_1 : ∀ m ∈ cubicsFrom 1,
    Lam (mul a1 [(m, 1)]) = 0 ∧ Lam (mul a2 [(m, 1)]) = 0 := by decide +kernel
theorem functional_kills_2 : ∀ m ∈ cubicsFrom 2,
    Lam (mul a1 [(m, 1)]) = 0 ∧ Lam (mul a2 [(m, 1)]) = 0 := by decide +kernel
theorem functional_kills_3 : ∀ m ∈ cubicsFrom 3,
    Lam (mul a1 [(m, 1)]) = 0 ∧ Lam (mul a2 [(m, 1)]) = 0 := by decide +kernel
