/-!
# Certificate: normalisation of the period polynomials a₁, a₂ (Fermat cubic sixfold)

Lean 4 core only: no Mathlib, no `native_decide`, no `sorry`.  GENERATED by
`night/lean_ob/gen_normalisation.py`, which recomputes all data and compares with
`night/fermat_exact/uniq_a.py`.  Companion of `ObstructionCert.lean`; the polynomials a₁, a₂ and the
definitions `Poly`, `mul`, `coeff`, `xdiff` are the same as there (specialised to integer coefficients).

R = ℤ[x₀,…,x₇]/(xᵢ²) (Jacobian ring of the Fermat cubic up to units), with basis the squarefree monomials;
φ : R₈ → ℤ is the coefficient of x₀⋯x₇.  A coefficient of a SQUAREFREE monomial in a product is the same
in ℤ[x] and in R, so everything below is computed in ℤ[x] and read off at squarefree monomials.

What the kernel checks:
 (a) `gram`: φ(a₁a₁) = 16, φ(a₁a₂) = -2, φ(a₂a₂) = 16, i.e. -2·(-8, 1, -8)  (`gram_ratio`).
 (b) for each of the two matchings: `aᵢ_killed`: (xᵢ+xⱼ)·aᵢ = 0 in R₅ for the four pairs;
     `minorᵢ_unit_triangular`: the 224 × 70 matrix of the map
         R₄ → (R₅)⁴,  a ↦ ((xᵢ+xⱼ)·a)_{pairs}
     (entry at row (pair, M), column m: coefficient of the quintic M in (xᵢ+xⱼ)·m) has a 69 × 69 minor
     that is lower triangular with unit diagonal; `minorᵢ_wellformed`: its rows are rows of that matrix
     and its columns are 69 distinct squarefree quartics.
NOT formalized: the linear algebra "a unit triangular 69 × 69 minor gives rank ≥ 69, so the solution
space in the 70-dimensional R₄ has dimension ≤ 1 and, containing aᵢ ≠ 0, is spanned by aᵢ"; and the
geometric meaning (period polynomials of the planes; the primitive intersection numbers -8, 1, -8).
-/
namespace NormalisationCert

/-- sparse integer polynomial in x₀..x₇: list of (monomial code Σ eᵢ·8ⁱ, coefficient), not normalised -/
abbrev Poly := List (Nat × Int)
/-- product; monomials multiply by adding codes (faithful here: all degrees ≤ 8, exponents ≤ 2) -/
def mul (p q : Poly) : Poly := p.flatMap fun s => q.map fun t => (s.1 + t.1, s.2 * t.2)
/-- coefficient of the monomial with code `m` -/
def coeff : Poly → Nat → Int
  | [], _ => 0
  | t :: p, m => if t.1 == m then t.2 + coeff p m else coeff p m
/-- xᵢ - xⱼ -/
def xdiff (i j : Nat) : Poly := [(8 ^ i, 1), (8 ^ j, -1)]
/-- xᵢ + xⱼ -/
def xsum (i j : Nat) : Poly := [(8 ^ i, 1), (8 ^ j, 1)]
/-- a₁ = (x₀-x₁)(x₂-x₃)(x₄-x₅)(x₆-x₇) -/
def a1 : Poly := mul (mul (xdiff 0 1) (xdiff 2 3)) (mul (xdiff 4 5) (xdiff 6 7))
/-- a₂ = (x₀-x₇)(x₁-x₂)(x₃-x₄)(x₅-x₆) -/
def a2 : Poly := mul (mul (xdiff 0 7) (xdiff 1 2)) (mul (xdiff 3 4) (xdiff 5 6))

/-! ## (a) Gram numbers -/

/-- φ: the coefficient of x₀x₁⋯x₇ -/
def phi (p : Poly) : Int := coeff p 0o11111111
/-- **Gram numbers:** φ(a₁a₁) = 16, φ(a₁a₂) = -2, φ(a₂a₂) = 16. -/
theorem gram : phi (mul a1 a1) = 16 ∧ phi (mul a1 a2) = -2 ∧ phi (mul a2 a2) = 16 := by decide +kernel
/-- they are -2 times (-8, 1, -8) -/
theorem gram_ratio : ((16 : Int), (-2 : Int), (16 : Int)) = (-2 * -8, -2 * 1, -2 * -8) := by decide

/-! ## (b) Uniqueness of aᵢ up to a scalar: common tools -/

/-- code of the squarefree monomial with variable set given by the bits of `b` -/
def codeOfMask (b : Nat) : Nat := ((List.range 8).map fun k => (b / 2 ^ k % 2) * 8 ^ k).sum
/-- number of variables in the mask -/
def popcount (b : Nat) : Nat := ((List.range 8).map fun k => b / 2 ^ k % 2).sum
/-- codes of the squarefree monomials of degree `d` -/
def sqfree (d : Nat) : List Nat := ((List.range 256).filter fun b => popcount b == d).map codeOfMask
theorem sqfree_counts : (sqfree 4).length = 70 ∧ (sqfree 5).length = 56 := by decide +kernel
/-- matrix entry: the coefficient of the quintic `M` in (xᵢ + xⱼ)·m -/
def entry (ij : Nat × Nat) (M m : Nat) : Int := coeff (mul (xsum ij.1 ij.2) [(m, 1)]) M
/-- the minor on the given rows (pair, M) and columns m -/
def minor (rows : List ((Nat × Nat) × Nat)) (cols : List Nat) : List (List Int) :=
  rows.map fun r => cols.map fun m => entry r.1 r.2 m
/-- entries on the diagonal are 1, entries above the diagonal are 0 -/
def unitLowerTriangular (L : List (List Int)) : Bool :=
  L.zipIdx.all fun (row, r) => row.zipIdx.all fun (e, c) =>
    if c == r then e == 1 else if r < c then e == 0 else true

/-! ## (b) for the matching of P1 = {x0+x1 = x2+x3 = x4+x5 = x6+x7 = 0} -/

def pairs1 : List (Nat × Nat) := [(0, 1), (2, 3), (4, 5), (6, 7)]
/-- **a1 is a solution:** (xᵢ + xⱼ)·a1 has no squarefree quintic term, for the four pairs (224 equations). -/
theorem a1_killed : ∀ ij ∈ pairs1, ∀ M ∈ sqfree 5, coeff (mul (xsum ij.1 ij.2) a1) M = 0 := by
