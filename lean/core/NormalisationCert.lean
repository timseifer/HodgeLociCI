/-- the selected rows are equations of the system and the selected columns are distinct quartics -/
theorem minor1_wellformed :
    rows1.all (fun r => pairs1.contains r.1 && (sqfree 5).contains r.2) = true
      ∧ cols1.all (fun m => (sqfree 4).contains m) = true ∧ cols1.Nodup
      ∧ rows1.length = 69 ∧ cols1.length = 69 := by decide +kernel
/-- **rank ≥ 69:** the 69 × 69 minor of the multiplication matrix on these rows and columns is lower
triangular with 1 on the diagonal (determinant 1). -/
theorem minor1_unit_triangular : unitLowerTriangular (minor rows1 cols1) = true := by decide +kernel

