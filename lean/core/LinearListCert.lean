        + (2 * n12 * n13 + 2 * n12 * n14 + 2 * n12 * n34 + 2 * n13 * n14 + 2 * n13 * n24 + 2 * n14 * n23) * (y1 * y1 * y2 * y2 * y3 * y4)
        + (2 * n12 * n14 + n14 * n14 + 2 * n14 * n24) * (y1 * y1 * y2 * y2 * y4 * y4)
