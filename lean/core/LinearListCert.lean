/-- [mod-ideal form] for N' = N + c1y1² + c2y2² + c3y3²: N'·m̄ = i3_L·y1y2y3 + y1²·(…) + y2²·(…) + y3²·(…), with the same i3_L -/
theorem i3_Nm_rep (a1 a2 a3 n12 n13 n23 c1 c2 c3 y1 y2 y3 : R) :
    (n12 * (y1 * y2) + n13 * (y1 * y3) + n23 * (y2 * y3) + c1 * (y1 * y1) + c2 * (y2 * y2) + c3 * (y3 * y3)) * (a1 * y1 + a2 * y2 + a3 * y3)
      = i3_L a1 a2 a3 n12 n13 n23 * (y1 * y2 * y3)
        + (y1 * y1) * ((a1 * c1) * y1 + (a1 * n12 + a2 * c1) * y2 + (a1 * n13 + a3 * c1) * y3)
