theorem i3_bezout_12 (a1 a2 a3 n12 n13 n23 : R) :
    2 * a1 * a2 * n12 * (i3_L a1 a2 a3 n12 n13 n23) - a2 * a2 * (i3_q1 a1 a2 a3 n12 n13 n23) - a1 * a1 * (i3_q2 a1 a2 a3 n12 n13 n23)
      = 2 * a1 * a2 * a3 * (n12 * n12) := by
  unfold i3_L i3_q1 i3_q2; grind

/-- [identity] 2a1a2a3·n13² as an explicit combination of i3_L, i3_q* -/
theorem i3_bezout_13 (a1 a2 a3 n12 n13 n23 : R) :
    2 * a1 * a3 * n13 * (i3_L a1 a2 a3 n12 n13 n23) - a3 * a3 * (i3_q1 a1 a2 a3 n12 n13 n23) - a1 * a1 * (i3_q3 a1 a2 a3 n12 n13 n23)
      = 2 * a1 * a2 * a3 * (n13 * n13) := by
  unfold i3_L i3_q1 i3_q3; grind

/-- [identity] 2a1a2a3·n23² as an explicit combination of i3_L, i3_q* -/
theorem i3_bezout_23 (a1 a2 a3 n12 n13 n23 : R) :
    2 * a2 * a3 * n23 * (i3_L a1 a2 a3 n12 n13 n23) - a3 * a3 * (i3_q2 a1 a2 a3 n12 n13 n23) - a2 * a2 * (i3_q3 a1 a2 a3 n12 n13 n23)
      = 2 * a1 * a2 * a3 * (n23 * n23) := by
  unfold i3_L i3_q2 i3_q3; grind

/-- [identity] i3_L = 0, i3_q1 = i3_q2 = i3_q3 = 0 ⟹ 2a1a2a3·n12² = 2a1a2a3·n13² = 2a1a2a3·n23² = 0 -/
theorem i3_no_common_zero (a1 a2 a3 n12 n13 n23 : R) (hL : i3_L a1 a2 a3 n12 n13 n23 = 0) (h1 : i3_q1 a1 a2 a3 n12 n13 n23 = 0) (h2 : i3_q2 a1 a2 a3 n12 n13 n23 = 0) (h3 : i3_q3 a1 a2 a3 n12 n13 n23 = 0) :
    (2 * a1 * a2 * a3 * (n12 * n12) = 0)
    ∧ (2 * a1 * a2 * a3 * (n13 * n13) = 0)
    ∧ (2 * a1 * a2 * a3 * (n23 * n23) = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · have h := i3_bezout_12 a1 a2 a3 n12 n13 n23
    rw [hL, h1, h2] at h
    grind
  · have h := i3_bezout_13 a1 a2 a3 n12 n13 n23
    rw [hL, h1, h3] at h
    grind
  · have h := i3_bezout_23 a1 a2 a3 n12 n13 n23
    rw [hL, h2, h3] at h
    grind

/-- [identity] the linear relation and n12n13 = n12n23 = n13n23 = 0 ⟹ a3·n12² = a2·n13² = a1·n23² = 0 -/
theorem i3_plain (a1 a2 a3 n12 n13 n23 : R) (hL : a3 * n12 + a2 * n13 + a1 * n23 = 0) (h1 : n12 * n13 = 0) (h2 : n12 * n23 = 0) (h3 : n13 * n23 = 0) :
    (a3 * (n12 * n12) = 0)
    ∧ (a2 * (n13 * n13) = 0)
    ∧ (a1 * (n23 * n23) = 0) := by
  refine ⟨?_, ?_, ?_⟩ <;> grind

