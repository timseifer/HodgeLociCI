/-- [full expansion] N²·m̄·y2; coefficients of yl³·Π_(i≠l) yi (l = 1..4) are i4_qs12, …, i4_qs42 -/
theorem i4_N2m_y2 (n12 n13 n14 n23 n24 n34 y1 y2 y3 y4 : R) :
    (n12 * (y1 * y2) + n13 * (y1 * y3) + n14 * (y1 * y4) + n23 * (y2 * y3) + n24 * (y2 * y4) + n34 * (y3 * y4)) * (n12 * (y1 * y2) + n13 * (y1 * y3) + n14 * (y1 * y4) + n23 * (y2 * y3) + n24 * (y2 * y4) + n34 * (y3 * y4)) * (y1 + y2 + y3 + y4) * y2
      = (n12 * n12) * (y1 * y1 * y1 * y2 * y2 * y2) + (2 * n12 * n13) * (y1 * y1 * y1 * y2 * y2 * y3)
        + (2 * n12 * n14) * (y1 * y1 * y1 * y2 * y2 * y4) + (n13 * n13) * (y1 * y1 * y1 * y2 * y3 * y3)
        + i4_qs12 n12 n13 n14 n23 n24 n34 * (y1 * y1 * y1 * y2 * y3 * y4) + (n14 * n14) * (y1 * y1 * y1 * y2 * y4 * y4)
        + (n12 * n12) * (y1 * y1 * y2 * y2 * y2 * y2)
