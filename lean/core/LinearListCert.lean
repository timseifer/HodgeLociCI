        + (a2 * c3 * c3 + 2 * a3 * n23 * c3) * (y2 * y3 * y3 * y3 * y3) + (a3 * c3 * c3) * (y3 * y3 * y3 * y3 * y3) := by
  unfold i3_L i3_q1 i3_q2 i3_q3; grind

/-- [mod-ideal form] N·m̄ = Σ i4_Lijk·yiyjyk + Σ yi²·(…) -/
theorem i4_Nm (n12 n13 n14 n23 n24 n34 y1 y2 y3 y4 : R) :
