        + (y3 * y3) * ((a1 * c3 + a3 * n13) * y1 + (a2 * c3 + a3 * n23) * y2 + (a3 * c3) * y3) := by
  unfold i3_L; grind

/-- [full expansion] N'²·m̄ for N' = N + Σ ci·yi²; coefficient of yl³·ym·yn is i3_ql + 2·cl·i3_L (so on E' the quadrics do not depend on the representative modulo (y1², y2², y3²)) -/
theorem i3_N2m_rep (a1 a2 a3 n12 n13 n23 c1 c2 c3 y1 y2 y3 : R) :
    (n12 * (y1 * y2) + n13 * (y1 * y3) + n23 * (y2 * y3) + c1 * (y1 * y1) + c2 * (y2 * y2) + c3 * (y3 * y3)) * (n12 * (y1 * y2) + n13 * (y1 * y3) + n23 * (y2 * y3) + c1 * (y1 * y1) + c2 * (y2 * y2) + c3 * (y3 * y3)) * (a1 * y1 + a2 * y2 + a3 * y3)
      = (a1 * c1 * c1) * (y1 * y1 * y1 * y1 * y1) + (2 * a1 * n12 * c1 + a2 * c1 * c1) * (y1 * y1 * y1 * y1 * y2)
        + (2 * a1 * n13 * c1 + a3 * c1 * c1) * (y1 * y1 * y1 * y1 * y3)
        + (a1 * n12 * n12 + 2 * a1 * c1 * c2 + 2 * a2 * n12 * c1) * (y1 * y1 * y1 * y2 * y2)
        + (i3_q1 a1 a2 a3 n12 n13 n23 + 2 * c1 * (i3_L a1 a2 a3 n12 n13 n23)) * (y1 * y1 * y1 * y2 * y3)
        + (a1 * n13 * n13 + 2 * a1 * c1 * c3 + 2 * a3 * n13 * c1) * (y1 * y1 * y1 * y3 * y3)
