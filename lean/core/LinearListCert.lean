/-- [identity] values of the 17 quadrics at the parametrised N (identities; al + be + ga = 0 is not used) -/
theorem i4_onE (al be ga : R) :
    (i4_qM al be ga ga be al = 2 * al * al + 2 * be * be + 2 * ga * ga)
    ∧ (i4_qs11 al be ga ga be al = 2 * al * al + 2 * al * be + 2 * al * ga + 2 * be * be + 2 * be * ga + 2 * ga * ga)
    ∧ (i4_qs12 al be ga ga be al = 2 * be * ga)
    ∧ (i4_qs13 al be ga ga be al = 2 * al * ga)
    ∧ (i4_qs14 al be ga ga be al = 2 * al * be)
    ∧ (i4_qs21 al be ga ga be al = 2 * be * ga)
    ∧ (i4_qs22 al be ga ga be al = 2 * al * al + 2 * al * be + 2 * al * ga + 2 * be * be + 2 * be * ga + 2 * ga * ga)
    ∧ (i4_qs23 al be ga ga be al = 2 * al * be)
    ∧ (i4_qs24 al be ga ga be al = 2 * al * ga)
    ∧ (i4_qs31 al be ga ga be al = 2 * al * ga)
    ∧ (i4_qs32 al be ga ga be al = 2 * al * be)
    ∧ (i4_qs33 al be ga ga be al = 2 * al * al + 2 * al * be + 2 * al * ga + 2 * be * be + 2 * be * ga + 2 * ga * ga)
    ∧ (i4_qs34 al be ga ga be al = 2 * be * ga)
    ∧ (i4_qs41 al be ga ga be al = 2 * al * be)
    ∧ (i4_qs42 al be ga ga be al = 2 * al * ga)
    ∧ (i4_qs43 al be ga ga be al = 2 * be * ga)
    ∧ (i4_qs44 al be ga ga be al = 2 * al * al + 2 * al * be + 2 * al * ga + 2 * be * be + 2 * be * ga + 2 * ga * ga) := by
  unfold i4_qM i4_qs11 i4_qs21 i4_qs31 i4_qs41 i4_qs12 i4_qs22 i4_qs32 i4_qs42 i4_qs13 i4_qs23 i4_qs33 i4_qs43 i4_qs14 i4_qs24 i4_qs34 i4_qs44; refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> grind

/-- [identity] i4_qM = 2s² − 4e2 and i4_qsll = 2s² − 2e2 at the parametrised N (s = al+be+ga, e2 = al·be+al·ga+be·ga); so on E' (s = 0) they are −4e2 and −2e2 -/
theorem i4_onE_sym (al be ga : R) :
    (i4_qM al be ga ga be al = 2 * (al + be + ga) * (al + be + ga) - 4 * (al * be + al * ga + be * ga))
    ∧ (i4_qs11 al be ga ga be al = 2 * (al + be + ga) * (al + be + ga) - 2 * (al * be + al * ga + be * ga))
    ∧ (i4_qs22 al be ga ga be al = 2 * (al + be + ga) * (al + be + ga) - 2 * (al * be + al * ga + be * ga))
    ∧ (i4_qs33 al be ga ga be al = 2 * (al + be + ga) * (al + be + ga) - 2 * (al * be + al * ga + be * ga))
    ∧ (i4_qs44 al be ga ga be al = 2 * (al + be + ga) * (al + be + ga) - 2 * (al * be + al * ga + be * ga)) := by
  unfold i4_qM i4_qs11 i4_qs22 i4_qs33 i4_qs44; refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> grind

/-- [identity] 2·al² = 2·al·(al+be+ga) − i4_qs14 − i4_qs13 at the parametrised N -/
theorem i4_bezout_al (al be ga : R) :
    2 * al * (al + be + ga) - (i4_qs14 al be ga ga be al) - (i4_qs13 al be ga ga be al)
      = 2 * (al * al) := by
  unfold i4_qs13 i4_qs14; grind

/-- [identity] 2·be² = 2·be·(al+be+ga) − i4_qs14 − i4_qs12 at the parametrised N -/
theorem i4_bezout_be (al be ga : R) :
    2 * be * (al + be + ga) - (i4_qs14 al be ga ga be al) - (i4_qs12 al be ga ga be al)
      = 2 * (be * be) := by
  unfold i4_qs12 i4_qs14; grind

/-- [identity] 2·ga² = 2·ga·(al+be+ga) − i4_qs13 − i4_qs12 at the parametrised N -/
theorem i4_bezout_ga (al be ga : R) :
    2 * ga * (al + be + ga) - (i4_qs13 al be ga ga be al) - (i4_qs12 al be ga ga be al)
      = 2 * (ga * ga) := by
  unfold i4_qs12 i4_qs13; grind

/-- [identity] al+be+ga = 0 and the three quadrics i4_qs14, i4_qs13, i4_qs12 = 0 ⟹ 2al² = 2be² = 2ga² = 0 -/
theorem i4_no_common_zero (al be ga : R) (hs : al + be + ga = 0) (h_al_be : i4_qs14 al be ga ga be al = 0) (h_al_ga : i4_qs13 al be ga ga be al = 0) (h_be_ga : i4_qs12 al be ga ga be al = 0) :
    (2 * (al * al) = 0)
    ∧ (2 * (be * be) = 0)
    ∧ (2 * (ga * ga) = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · have h := i4_bezout_al al be ga
    rw [hs, h_al_be, h_al_ga] at h
    grind
  · have h := i4_bezout_be al be ga
    rw [hs, h_al_be, h_be_ga] at h
    grind
  · have h := i4_bezout_ga al be ga
    rw [hs, h_al_ga, h_be_ga] at h
    grind

