theorem i5_adj (y1 y2 y3 : R) :
    (y1 * (y1 + y2 + y3) + y2 * (-y3) = (y1 * (y1 + y2 + y3) - y2 * y3))
    ∧ (y1 * (-y2) + y2 * y1 = 0)
    ∧ (y3 * (y1 + y2 + y3) + (y1 + y2 + y3) * (-y3) = 0)
    ∧ (y3 * (-y2) + (y1 + y2 + y3) * y1 = (y1 * (y1 + y2 + y3) - y2 * y3)) := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> grind

/-- [mod-ideal form] N·m̄ = i5_L·y1y2y3 + y1²·(…) + y2²·(…) + y3²·(…) -/
theorem i5_Nm (n1 n2 n3 y1 y2 y3 : R) :
    (n1 * y1 + n2 * y2 + n3 * y3) * (y1 * (y1 + y2 + y3) - y2 * y3)
      = i5_L n1 n2 n3 * (y1 * y2 * y3) + (y1 * y1) * (n1 * y1 + (n1 + n2) * y2 + (n1 + n3) * y3)
        + (y2 * y2) * (n2 * y1 + (-n2) * y3) + (y3 * y3) * (n3 * y1 + (-n3) * y2) := by
  unfold i5_L; grind

/-- [full expansion] N²·adj(M̄)_(00); coefficient of y1y2y3 is i5_q00 (Q = f_0 h_0) -/
theorem i5_N2adj_00 (n1 n2 n3 y1 y2 y3 : R) :
    (n1 * y1 + n2 * y2 + n3 * y3) * (n1 * y1 + n2 * y2 + n3 * y3) * (y1 + y2 + y3)
      = (n1 * n1) * (y1 * y1 * y1) + (n1 * n1 + 2 * n1 * n2) * (y1 * y1 * y2) + (n1 * n1 + 2 * n1 * n3) * (y1 * y1 * y3)
        + (2 * n1 * n2 + n2 * n2) * (y1 * y2 * y2) + i5_q00 n1 n2 n3 * (y1 * y2 * y3)
        + (2 * n1 * n3 + n3 * n3) * (y1 * y3 * y3) + (n2 * n2) * (y2 * y2 * y2)
        + (n2 * n2 + 2 * n2 * n3) * (y2 * y2 * y3) + (2 * n2 * n3 + n3 * n3) * (y2 * y3 * y3)
        + (n3 * n3) * (y3 * y3 * y3) := by
  unfold i5_q00; grind

/-- [full expansion] N²·adj(M̄)_(10); coefficient of y1y2y3 is i5_q01 (Q = f_0 h_1) -/
theorem i5_N2adj_01 (n1 n2 n3 y1 y2 y3 : R) :
    (n1 * y1 + n2 * y2 + n3 * y3) * (n1 * y1 + n2 * y2 + n3 * y3) * (-y3)
      = (-(n1 * n1)) * (y1 * y1 * y3) + i5_q01 n1 n2 n3 * (y1 * y2 * y3) + (-(2 * n1 * n3)) * (y1 * y3 * y3)
        + (-(n2 * n2)) * (y2 * y2 * y3) + (-(2 * n2 * n3)) * (y2 * y3 * y3) + (-(n3 * n3)) * (y3 * y3 * y3) := by
  unfold i5_q01; grind

/-- [full expansion] N²·adj(M̄)_(01); coefficient of y1y2y3 is i5_q10 (Q = f_1 h_0) -/
theorem i5_N2adj_10 (n1 n2 n3 y1 y2 y3 : R) :
    (n1 * y1 + n2 * y2 + n3 * y3) * (n1 * y1 + n2 * y2 + n3 * y3) * (-y2)
      = (-(n1 * n1)) * (y1 * y1 * y2) + (-(2 * n1 * n2)) * (y1 * y2 * y2) + i5_q10 n1 n2 n3 * (y1 * y2 * y3)
        + (-(n2 * n2)) * (y2 * y2 * y2) + (-(2 * n2 * n3)) * (y2 * y2 * y3) + (-(n3 * n3)) * (y2 * y3 * y3) := by
  unfold i5_q10; grind

/-- [full expansion] N²·adj(M̄)_(11); coefficient of y1y2y3 is i5_q11 (Q = f_1 h_1) -/
theorem i5_N2adj_11 (n1 n2 n3 y1 y2 y3 : R) :
    (n1 * y1 + n2 * y2 + n3 * y3) * (n1 * y1 + n2 * y2 + n3 * y3) * y1
      = (n1 * n1) * (y1 * y1 * y1) + (2 * n1 * n2) * (y1 * y1 * y2) + (2 * n1 * n3) * (y1 * y1 * y3)
        + (n2 * n2) * (y1 * y2 * y2) + i5_q11 n1 n2 n3 * (y1 * y2 * y3) + (n3 * n3) * (y1 * y3 * y3) := by
  unfold i5_q11; grind

/-- [identity] 2·n1² as an explicit combination of i5_L, i5_q01, i5_q10, i5_q11 -/
theorem i5_bezout_n1 (n1 n2 n3 : R) :
    -2 * n1 * (i5_L n1 n2 n3) - (i5_q01 n1 n2 n3) - (i5_q10 n1 n2 n3)
      = 2 * (n1 * n1) := by
  unfold i5_L i5_q01 i5_q10; grind

/-- [identity] 2·n2² as an explicit combination of i5_L, i5_q01, i5_q10, i5_q11 -/
theorem i5_bezout_n2 (n1 n2 n3 : R) :
    2 * n2 * (i5_L n1 n2 n3) - (i5_q01 n1 n2 n3) - (i5_q11 n1 n2 n3)
      = 2 * (n2 * n2) := by
  unfold i5_L i5_q01 i5_q11; grind

/-- [identity] 2·n3² as an explicit combination of i5_L, i5_q01, i5_q10, i5_q11 -/
theorem i5_bezout_n3 (n1 n2 n3 : R) :
    2 * n3 * (i5_L n1 n2 n3) - (i5_q10 n1 n2 n3) - (i5_q11 n1 n2 n3)
      = 2 * (n3 * n3) := by
  unfold i5_L i5_q10 i5_q11; grind

/-- [identity] i5_L = 0 and i5_q01 = i5_q10 = i5_q11 = 0 ⟹ 2n1² = 2n2² = 2n3² = 0 -/
theorem i5_no_common_zero (n1 n2 n3 : R) (hL : i5_L n1 n2 n3 = 0) (h01 : i5_q01 n1 n2 n3 = 0) (h10 : i5_q10 n1 n2 n3 = 0) (h11 : i5_q11 n1 n2 n3 = 0) :
    (2 * (n1 * n1) = 0)
    ∧ (2 * (n2 * n2) = 0)
    ∧ (2 * (n3 * n3) = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · have h := i5_bezout_n1 n1 n2 n3
    rw [hL, h01, h10] at h
    grind
  · have h := i5_bezout_n2 n1 n2 n3
    rw [hL, h01, h11] at h
    grind
  · have h := i5_bezout_n3 n1 n2 n3
    rw [hL, h10, h11] at h
    grind

/-- [identity] i5_q00 = i5_q11 − i5_q01 − i5_q10 (the fourth quadric adds nothing) -/
theorem i5_q00_sum (n1 n2 n3 : R) :
    i5_q00 n1 n2 n3
      = (i5_q11 n1 n2 n3) - (i5_q01 n1 n2 n3) - (i5_q10 n1 n2 n3) := by
  unfold i5_q00 i5_q01 i5_q10 i5_q11; grind

end LinearListCert

