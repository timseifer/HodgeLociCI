        + (2 * a1 * n12 * n23 + 2 * a1 * n13 * c2 + 2 * a2 * n12 * n13 + 2 * a2 * n23 * c1 + a3 * n12 * n12 + 2 * a3 * c1 * c2) * (y1 * y1 * y2 * y2 * y3)
        + (2 * a1 * n12 * c3 + 2 * a1 * n13 * n23 + a2 * n13 * n13 + 2 * a2 * c1 * c3 + 2 * a3 * n12 * n13 + 2 * a3 * n23 * c1) * (y1 * y1 * y2 * y3 * y3)
        + (2 * a1 * n13 * c3 + a3 * n13 * n13 + 2 * a3 * c1 * c3) * (y1 * y1 * y3 * y3 * y3)
