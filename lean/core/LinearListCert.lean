    (2 * (n12 - n34) = (i4_L123 n12 n13 n14 n23 n24 n34) + (i4_L124 n12 n13 n14 n23 n24 n34) - (i4_L134 n12 n13 n14 n23 n24 n34) - (i4_L234 n12 n13 n14 n23 n24 n34))
    ∧ (2 * (n13 - n24) = (i4_L123 n12 n13 n14 n23 n24 n34) - (i4_L124 n12 n13 n14 n23 n24 n34) + (i4_L134 n12 n13 n14 n23 n24 n34) - (i4_L234 n12 n13 n14 n23 n24 n34))
    ∧ (2 * (n14 - n23) = -(i4_L123 n12 n13 n14 n23 n24 n34) + (i4_L124 n12 n13 n14 n23 n24 n34) + (i4_L134 n12 n13 n14 n23 n24 n34) - (i4_L234 n12 n13 n14 n23 n24 n34))
    ∧ (2 * (n12 + n13 + n14) = (i4_L123 n12 n13 n14 n23 n24 n34) + (i4_L124 n12 n13 n14 n23 n24 n34) + (i4_L134 n12 n13 n14 n23 n24 n34) - (i4_L234 n12 n13 n14 n23 n24 n34)) := by
  unfold i4_L123 i4_L124 i4_L134 i4_L234; refine ⟨?_, ?_, ?_, ?_⟩ <;> grind

